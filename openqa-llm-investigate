USER_AGENT = "openqa-llm-investigate (https://github.com/os-autoinst/os-autoinst-scripts)"
DEFAULT_OPENQA_TIMEOUT: float = 90.0
DEFAULT_INVESTIGATION_TIMEOUT: float = 900.0
COMMENT_MARKER = "**LLM Investigation summary:**"
OUTAGE_HINT = (
    "\n(Note: {build_failures} failures across this build strongly implies a backend infrastructure outage"
    " or a widespread environment issue rather than a specific product bug.)"
)
DEFAULT_PROMPT_TEMPLATE = """You are analyzing an openQA test run failure.
Job details:
- Test: {test_name}
- Failed module(s): {failed_modules}
- Group: {group}
- Build: {build}
- Distri: {distri}
- Version: {version}
- Arch: {arch}
- Flavor: {flavor}
- Result: {result}
- Total failed jobs in this build (across all tests): {build_failures}{hint}
- Other jobs in this build failing in the exact same module(s): {same_module_failures}
- Consecutive recent failures for this specific test (same name, arch, flavor): {consecutive_failures}

Investigation info (diff to last good):
{investigation_info}

Failure analysis (context window of {context_lines} lines{truncated}):
{analysis}{prompt_extension_text}

Answer in exactly this order and nothing else.

1. One line per failed module of the analysis, formatted `* module_name: #N \u2014 REASON`. N is the number of the
   failing command, taken from the `# Cmd[N]: COMMAND (exit CODE)` lines of that module. If the module has a single
   command, write `* module_name: REASON` instead. REASON has at most 20 words in plain language: name the failing
   component first, then the cause. Write `analysis unavailable` as REASON if the data is not sufficient.

2. A brief Markdown summary: at most 2 sentences, then optionally `**Likely cause:**` with 2-4 bullets and
   `**Suggested actions:**` as a numbered list. Every bullet is one sentence of at most 20 words. Use backticks for
   commands, files and errors. Do not invent causes and never ask for more data.

3. The bullet `- Classification: Product bug | Test issue | Infrastructure problem`, choosing exactly one value.
   Product bug: the software under test is wrong. Test issue: test code, needle or test data is wrong.
   Infrastructure problem: network, worker or external service.

4. A last line starting EXACTLY with "BISECT: YES" or "BISECT: NO" followed by `\u2014 reason`, deciding whether
   'openqa-investigate' should be triggered to schedule further bisect tests.
   - If other jobs in the same build are failing in the exact same module, this is a widespread issue. You MUST answer
     BISECT: NO to prevent redundant and costly bisections, as another job has likely already triggered it.
   - If the failure is isolated to ONLY this job in the current build, AND the analysis contains an explicit product
     error or test assertion failure (e.g., 'actual size fits X: fail', 'command not found', 'segmentation fault'),
     it strongly points to a new regression. In this isolated case, you MUST answer BISECT: YES.
"""

TRUNCATED_NOTE = ", truncated to the first {log_lines} lines; do not guess about the omitted tail"
_BISECT_RE = re.compile(r"^[\s*_`>-]*BISECT:\s*(YES|NO)\b", re.IGNORECASE)

log = logging.getLogger(__name__)


class TransientHTTPError(Exception):
    """Exception raised for HTTP responses with transient status codes."""

    def __init__(self, response: httpx.Response) -> None:
        """Initialize the exception with the HTTP response."""
        super().__init__(f"HTTP {response.status_code}")
        self.response = response


class RetryTransport(httpx.HTTPTransport):
    """Custom HTTP transport that retries on transient errors (e.g. 429, 5xx) and timeouts."""

    RETRY_STATUS_CODES = frozenset({408, 429, 500, 502, 503, 504})

    def __init__(self, retries: int = 1, **kwargs: Any) -> None:
        """Initialize the RetryTransport with a configurable number of retries."""
        super().__init__(**kwargs)
        self.retries = retries

    @staticmethod
    def _now() -> datetime.datetime:
        return datetime.datetime.now(datetime.UTC)

    def _check_and_raise(self, response: httpx.Response) -> None:
        if response.status_code in self.RETRY_STATUS_CODES:
            raise TransientHTTPError(response)

    def _wait_strategy(self, retry_state: tenacity.RetryCallState) -> float:
        exc = retry_state.outcome.exception()
        if isinstance(exc, TransientHTTPError):
            response = exc.response
            retry_after = response.headers.get("Retry-After")
            if retry_after:
                try:
                    delay = float(retry_after)
                    if delay > 0.0:
                        return delay
                except ValueError:
                    try:
                        dt = parsedate_to_datetime(retry_after)
                        delay = (dt - self._now()).total_seconds()
                        if delay > 0.0:
                            return delay
                    except Exception as e:
                        log.debug("Failed to parse Retry-After header as date: %s", e)

        return float(2 ** (retry_state.attempt_number - 1))

    def _before_sleep(self, retry_state: tenacity.RetryCallState) -> None:
        exc = retry_state.outcome.exception()
        retries_left = self.retries - retry_state.attempt_number
        delay = retry_state.next_action.sleep

        if isinstance(exc, TransientHTTPError):
            response = exc.response
            response.close()

            log.info(
                "Received HTTP %d. Retrying in %.2f seconds (%d retries left)...",
                response.status_code,
                delay,
                retries_left,
            )
        elif isinstance(exc, httpx.TimeoutException):
            log.warning(
                "Request timed out (%s). Retrying in %.2f seconds (%d retries left)...",
                type(exc).__name__,
                delay,
                retries_left,
            )

    def handle_request(self, request: httpx.Request) -> httpx.Response:
        """Handle the HTTP request, retrying on transient status codes and timeouts if retries are available."""
        try:
            for attempt in tenacity.Retrying(
                retry=tenacity.retry_if_exception_type((TransientHTTPError, httpx.TimeoutException)),
                stop=tenacity.stop_after_attempt(self.retries + 1),
                wait=self._wait_strategy,
                before_sleep=self._before_sleep,
                reraise=True,
            ):
                with attempt:
                    response = super().handle_request(request)
                    self._check_and_raise(response)
        except TransientHTTPError as e:
            return e.response

        return response


app = typer.Typer(add_completion=False)


@dataclass(frozen=True)
class Options:
    """Settings of one investigation."""

    llm_url: str
    llm_model: str
    llm_token: str | None
    llm_timeout: int
    context_lines: int
    log_lines: int
    history_limit: int
    build_failure_threshold: int
    prompt_template_file: str | None
    investigation_timeout: float = DEFAULT_INVESTIGATION_TIMEOUT
    force: bool = False
    dry: bool = False


def fetch_json(
    client: httpx.Client,
    url: str,
    params: dict[str, Any] | None = None,
    default: Any = None,
    timeout: float | None = None,
) -> Any:
    try:
        kwargs: dict[str, Any] = {"params": params}
        if timeout is not None:
            kwargs["timeout"] = timeout
        response = client.get(url, **kwargs)
        response.raise_for_status()
        return response.json()
    except Exception as e:
        log.warning("Failed to fetch JSON from %s with params %s: %s", url, params, e)
        return default if default is not None else {}


def post_comment(base_url: str, job_id: str, comment: str) -> None:
    cmd = [
        "openqa-cli",
        "api",
        "--header",
        f"User-Agent: {USER_AGENT}",
        "--host",
        base_url,
        "-X",
        "POST",
        f"jobs/{job_id}/comments",
        f"text={comment}",
    ]
    try:
        res = subprocess.run(cmd, check=True, capture_output=True, text=True)
        log.debug("Posted comment to %s/t%s: %s", base_url, job_id, res.stdout)
    except subprocess.CalledProcessError as e:
        log.error("Failed to post comment: %s", e.stderr)


def setup_logging(verbose: int, quiet: bool) -> None:
    if quiet:
        level = logging.ERROR
    elif verbose >= 2:
        level = logging.DEBUG
    elif verbose >= 1:
        level = logging.INFO
    else:
        level = logging.WARNING
    logging.basicConfig(level=level, format="%(levelname)s: %(message)s", stream=sys.stderr, force=True)


def parse_job_url(job_url: str) -> tuple[str, str]:
    parsed_url = urlparse(job_url)
    if parsed_url.scheme:
        base_url = urlunparse((parsed_url.scheme, parsed_url.netloc, "", "", "", ""))
        job_id = parsed_url.path.replace("/tests/", "", 1)
    else:
        base_url = os.environ.get("OPENQA_URL", "https://openqa.opensuse.org")
        job_id = job_url
    return base_url, job_id


def _shares_failed_modules(other_job: dict[str, Any], target_modules: set[str]) -> bool:
    """Check if the given job has failures in any of the target modules."""
    other_failed = (m.get("name") for m in other_job.get("modules", []) if m.get("result") == "failed")
    return bool(target_modules.intersection(other_failed))


def _call_llm_api(client: httpx.Client, opts: Options, prompt: str) -> str:
    llm_url, llm_model, llm_token, timeout = opts.llm_url, opts.llm_model, opts.llm_token, opts.llm_timeout
    req = {
        "model": llm_model,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.3,
    }
    headers = {"Authorization": f"Bearer {llm_token}"} if llm_token else {}
    try:
        res = client.post(llm_url, json=req, headers=headers, timeout=timeout)
        res.raise_for_status()
        res_json = res.json()
        return res_json["choices"][0]["message"]["content"]
    except httpx.ConnectError:
        log.error(
            "Could not connect to LLM server at %s. Please check if the server is running"
            " or the LLM_API_URL environment variable is correct.",
            llm_url,
        )
        sys.exit(1)
    except httpx.HTTPStatusError as e:
        log.error("LLM API %s (%s) status %d: %s", llm_url, llm_model, e.response.status_code, e.response.text)
        sys.exit(1)
    except Exception as e:
        log.error("LLM API %s (%s) failed: %s", llm_url, llm_model, e)
        sys.exit(1)


def _fetch_job(client: httpx.Client, base_url: str, job_id: str) -> dict[str, Any]:
    job_data = fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}/details")
    if not job_data or "job" not in job_data:
        # Fallback for openQA versions/configurations where /details might fail
        job_data = fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}")
    if not job_data or "job" not in job_data:
        log.error("Could not retrieve job data for job %s from %s", job_id, base_url)
        sys.exit(1)
    return job_data["job"]


def _analyze(client: httpx.Client, base_url: str, job_id: str, job: dict[str, Any], opts: Options) -> str:
    """Return the failure analysis; exit when there is nothing to analyze unless forced."""
    oqa = OpenQA(client, base_url)
    softfailed = job.get("result") == "softfailed"
    try:
        return analyze_job(oqa, job_id, context_lines=opts.context_lines, include_softfailed=softfailed, job=job)
    except NoFailedModulesError as e:
        if not opts.force:
            log.info("Job %s: %s", job_id, e)
            sys.exit(0)
        return e.partial_output
    except AnalyzerError as e:
        log.error("Could not analyze job %s: %s", job_id, e)
        sys.exit(1)
    except Exception:
        log.exception("Unexpected error analyzing job %s", job_id)
        sys.exit(1)


def _bisect_recommended(response: str) -> bool:
    """Return True if the last `BISECT: YES|NO` verdict line of the response is YES."""
    for ln in reversed(response.splitlines()):
        if m := _BISECT_RE.match(ln):
            return m.group(1).upper() == "YES"
    return False


def _cap_lines(text: str, max_lines: int) -> tuple[str, bool]:
    """Keep the first `max_lines` lines of `text` behind an omission note; return it and whether it was cut."""
    lines = text.splitlines()
    if len(lines) <= max_lines:
        return text, False
    note = f"[... {len(lines) - max_lines} lines omitted: --log-lines cap of {max_lines} reached ...]"
    return "\n".join([*lines[:max_lines], note]) + "\n", True


def _consecutive_failures(client: httpx.Client, base_url: str, job_id: str, job: dict[str, Any], limit: int) -> int:
    """Count the failures in a row of the same test (name, arch, flavor) up to this job."""
    settings = job.get("settings", {})
    params = {
        "test": job.get("test", "unknown"),
        "distri": settings.get("DISTRI", "unknown"),
        "version": settings.get("VERSION", "unknown"),
        "arch": settings.get("ARCH", "unknown"),
        "flavor": settings.get("FLAVOR", "unknown"),
        "limit": limit,
    }
    test_jobs = fetch_json(client, f"{base_url}/api/v1/jobs", params=params).get("jobs", [])
    target = int(job_id)
    if not any(j["id"] == target for j in test_jobs):
        log.warning("Job %s not found in recent history (limit %s). Streak count may be inaccurate.", job_id, limit)
    relevant = sorted((j for j in test_jobs if j["id"] <= target), key=itemgetter("id"), reverse=True)
    relevant = [
        j for j in relevant if j.get("state") == "done" and j.get("result") in {"passed", "softfailed", "failed"}
    ]
    return next((i for i, j in enumerate(relevant) if j.get("result") != "failed"), len(relevant))


def _build_failures(client: httpx.Client, base_url: str, job_id: str, job: dict[str, Any]) -> tuple[int, int]:
    """Return the failed jobs of this build and those among them failing in the same module(s)."""
    settings = job.get("settings", {})
    params = {k.lower(): settings.get(k, "unknown") for k in ("BUILD", "DISTRI", "VERSION")} | {"result": "failed"}
    failed_jobs = fetch_json(client, f"{base_url}/api/v1/jobs", params=params).get("jobs", [])
    modules = {m.get("name", "unknown") for m in job.get("testresults", []) if m.get("result") == "failed"}
    similar = sum(1 for j in failed_jobs if str(j.get("id")) != str(job_id) and _shares_failed_modules(j, modules))
    return len(failed_jobs), similar if modules else 0


def _build_prompt(job: dict[str, Any], analysis: str, stats: dict[str, Any], opts: Options) -> str:
    settings = job.get("settings", {})
    failed_modules = [m.get("name", "unknown") for m in job.get("testresults", []) if m.get("result") == "failed"]
    hint = (
        OUTAGE_HINT.format(build_failures=stats["build_failures"])
        if stats["build_failures"] > opts.build_failure_threshold
        else ""
    )
    extension = settings.get("LLM_PROMPT_EXTENSION")
    extension_text = f"\n\nTest-specific instructions from openQA variables:\n{extension}\n" if extension else ""
    template = DEFAULT_PROMPT_TEMPLATE
    if opts.prompt_template_file:
        try:
            template = pathlib.Path(opts.prompt_template_file).read_text(encoding="utf-8")
        except OSError as e:
            log.error("Could not read prompt template file %s: %s", opts.prompt_template_file, e)
            sys.exit(1)
    analysis, truncated = _cap_lines(analysis, opts.log_lines)
    if truncated:
        log.warning("Failure analysis cut to --log-lines=%d; raise it if the cut-off tail matters", opts.log_lines)
    fields = dict(
        test_name=job.get("test", "unknown"),
        failed_modules=", ".join(failed_modules) or "unknown",
        group=job.get("group", "unknown"),
        build=settings.get("BUILD", "unknown"),
        distri=settings.get("DISTRI", "unknown"),
        version=settings.get("VERSION", "unknown"),
        arch=settings.get("ARCH", "unknown"),
        flavor=settings.get("FLAVOR", "unknown"),
        result=job.get("result", "unknown"),
        context_lines=opts.context_lines,
        analysis=analysis,
        truncated=TRUNCATED_NOTE.format(log_lines=opts.log_lines) if truncated else "",
        log_lines=opts.log_lines,
        log_text=analysis,
        hint=hint,
        prompt_extension_text=extension_text,
        **stats,
    )
    try:
        return template.format(**fields)
    except (KeyError, IndexError, AttributeError, TypeError) as e:
        log.error("Prompt template uses unknown placeholder %s; available: %s", e, ", ".join(sorted(fields)))
        sys.exit(1)
    except ValueError as e:
        log.error("Invalid prompt template: %s (escape literal braces as {{ and }})", e)
        sys.exit(1)


def _perform_investigation(client: httpx.Client, base_url: str, job_id: str, opts: Options) -> None:
    comments = fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}/comments", default=[])
    if not opts.force and any(c.get("text", "").startswith(COMMENT_MARKER) for c in comments):
        log.info("Job %s already has an LLM investigation summary, skipping.", job_id)
        sys.exit(0)

    job = _fetch_job(client, base_url, job_id)
    if not opts.force and job.get("result") in {"passed", "softfailed"}:
        log.info("Job %s %s, skipping investigation.", job_id, job.get("result"))
        sys.exit(0)

    analysis = _analyze(client, base_url, job_id, job, opts)
    investigation = fetch_json(
        client, f"{base_url}/tests/{job_id}/investigation_ajax", timeout=opts.investigation_timeout
    )
    build_failures, same_module_failures = _build_failures(client, base_url, job_id, job)
    stats = {
        "build_failures": build_failures,
        "same_module_failures": same_module_failures,
        "consecutive_failures": _consecutive_failures(client, base_url, job_id, job, opts.history_limit),
        "investigation_info": redact(json.dumps(investigation.get("diff_to_last_good", "None available"))),
    }
    prompt = _build_prompt(job, analysis, stats, opts)
    llm_response = _call_llm_api(client, opts, prompt)

    # Print the job URL to stdout ONLY if BISECT: YES is recommended
    # This makes the script act as a gatekeeper, similar to `openqa-label-known-issues`
    if _bisect_recommended(llm_response):
        print(f"{base_url}/tests/{job_id}")  # ruff: ignore[print]

    if opts.dry:
        print(f"{COMMENT_MARKER}\n\n{llm_response}")  # ruff: ignore[print]
    else:
        post_comment(base_url, job_id, f"{COMMENT_MARKER}\n\n{llm_response}")


@app.command()
def investigate(
    job_url: str = typer.Argument(..., help="The openQA test URL or job ID for which to trigger LLM investigation"),
    verbose: Annotated[int, typer.Option("--verbose", "-v", count=True, help="Increase verbosity")] = 0,
    quiet: Annotated[bool, typer.Option("--quiet", "-q", help="Quiet mode")] = False,  # ruff: ignore[boolean-default-value-positional-argument]
    dry: Annotated[  # ruff: ignore[boolean-default-value-positional-argument]
        bool, typer.Option("--dry", help="Dry run mode: output summary instead of posting a comment")
    ] = False,
    force: Annotated[  # ruff: ignore[boolean-default-value-positional-argument]
        bool,
        typer.Option(
            "--force",
            "-f",
            help="Force another analysis even if an LLM comment already exists or if the job passed/softfailed",
        ),
    ] = False,
    timeout: Annotated[
        int,
        typer.Option("--timeout", envvar="LLM_TIMEOUT", help="Timeout for LLM API requests in seconds"),
    ] = 600,
    retries: Annotated[
        int,
        typer.Option(
            "--retries",
            envvar="LLM_RETRIES",
            help="Number of retries on retry-worthy HTTP responses and timeouts",
        ),
    ] = 7,
    llm_url: Annotated[
        str,
        typer.Option("--llm-url", envvar="LLM_API_URL", help="URL for the LLM API endpoint"),
    ] = "http://localhost:8080/v1/chat/completions",
    llm_model: Annotated[
        str,
        typer.Option("--llm-model", envvar="LLM_MODEL", help="The LLM model to use"),
    ] = "gemma-4-26B-A4B-it",
    llm_token: Annotated[
        str | None,
        typer.Option("--llm-token", envvar="LLM_API_TOKEN", help="API token for authentication"),
    ] = None,
    context_lines: Annotated[
        int,
        typer.Option(
            "--context-lines", envvar="LLM_CONTEXT_LINES", min=0, help="Lines of log context around each failure"
        ),
    ] = 100,
    log_lines: Annotated[
        int,
        typer.Option(
            "--log-lines",
            envvar="LLM_LOG_LINES",
            min=0,
            help="Maximum lines of failure analysis sent to the LLM (formerly the autoinst log tail length)",
        ),
    ] = 500,
    history_limit: Annotated[
        int,
        typer.Option("--history-limit", envvar="LLM_HISTORY_LIMIT", help="Limit for consecutive failure lookup"),
    ] = 100,
    build_failure_threshold: Annotated[
        int,
        typer.Option(
            "--build-failure-threshold",
            envvar="LLM_BUILD_FAILURE_THRESHOLD",
            help="Threshold for infrastructure outage hint",
        ),
    ] = 20,
    prompt_template_file: Annotated[
        str | None,
        typer.Option(
            "--prompt-template-file",
            envvar="LLM_PROMPT_TEMPLATE_FILE",
            help="File containing the prompt template to use; escape literal braces as {{ and }}",
        ),
    ] = None,
    openqa_timeout: Annotated[
        float,
        typer.Option(
            "--openqa-timeout",
            envvar=["OPENQA_HTTP_TIMEOUT_S"],
            help="Timeout for openQA HTTP requests in seconds",
        ),
    ] = DEFAULT_OPENQA_TIMEOUT,
    investigation_timeout: Annotated[
        float,
        typer.Option(
            "--investigation-timeout",
            envvar=["OPENQA_INVESTIGATION_TIMEOUT_S"],
            help="Timeout for investigation_ajax HTTP requests in seconds",
        ),
    ] = DEFAULT_INVESTIGATION_TIMEOUT,
) -> None:
    setup_logging(verbose, quiet)
    base_url, job_id = parse_job_url(job_url)

    if not job_id.isdigit():
        log.error("Invalid job ID: %s", job_id)
        sys.exit(1)

    opts = Options(
        llm_url=llm_url,
        llm_model=llm_model,
        llm_token=llm_token,
        llm_timeout=timeout,
        context_lines=context_lines,
        log_lines=log_lines,
        history_limit=history_limit,
        build_failure_threshold=build_failure_threshold,
        prompt_template_file=prompt_template_file,
        investigation_timeout=investigation_timeout,
        force=force,
        dry=dry,
    )
    transport = RetryTransport(retries=retries)
    with httpx.Client(transport=transport, headers={"User-Agent": USER_AGENT}, timeout=openqa_timeout) as client:
        _perform_investigation(client, base_url, job_id, opts)


if __name__ == "__main__":
    app()

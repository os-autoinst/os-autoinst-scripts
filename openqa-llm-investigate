class LlmApi(StrEnum):
    """Chat API flavour of the LLM endpoint."""

    AUTO = "auto"
    OPENAI = "openai"
    OLLAMA = "ollama"
    VERTEX = "vertex"


@dataclass(frozen=True)
class Options:
    """Settings of one investigation."""

    llm_url: str
    llm_model: str
    llm_token: str | None
    llm_timeout: int
    context_lines: int
    log_lines: int
    history_limit: int
    build_failure_threshold: int
    context_tokens: int = 0
    llm_api: LlmApi = LlmApi.AUTO
    investigation_timeout: float = DEFAULT_INVESTIGATION_TIMEOUT
    force: bool = False
    dry: bool = False
    print_prompt: bool = False


def fetch_json(
    client: httpx.Client,
    url: str,
    params: dict[str, Any] | None = None,
    default: Any = None,  # ruff: ignore[any-type]
    timeout: float | None = None,
) -> Any:  # ruff: ignore[any-type]
    """Fetch JSON from a URL and return it, or the default if it fails."""
    try:
        kwargs: dict[str, Any] = {"params": params}
        if timeout is not None:
            kwargs["timeout"] = timeout
        response = client.get(url, **kwargs)
        response.raise_for_status()
        return response.json()
    except (httpx.RequestError, httpx.HTTPStatusError, ValueError) as e:
        if e.response.status_code == HTTPStatus.NOT_FOUND:
            log.debug("JSON endpoint %s returned 404 Not Found", url)
            return default if default is not None else {"error_status": HTTPStatus.NOT_FOUND}
        log.warning("Failed to fetch JSON from %s with params %s: %s", url, params, e)
        return default if default is not None else {}


def post_comment(base_url: str, job_id: str, comment: str) -> None:
    """Post a comment to an openQA job."""
    cmd = [
        "openqa-cli",
        "api",
        "--header",
        f"User-Agent: {USER_AGENT}",
        "--host",
        base_url,
        "-X",
        "POST",
        f"jobs/{job_id}/comments",
        f"text={comment}",
    ]
    try:
        res = subprocess.run(cmd, check=True, capture_output=True, text=True)
        log.debug("Posted comment to %s/t%s: %s", base_url, job_id, res.stdout)
    except subprocess.CalledProcessError as e:
        if is_404_str(e.stderr):
            log.info("Could not post comment as job %s has been deleted.", job_id)
            return
        log.exception("Failed to post comment: %s", e.stderr)


def setup_logging(verbose: int, *, quiet: bool) -> None:
    """Configure logging level based on verbosity."""
    if quiet:
        level = logging.ERROR
    elif verbose >= 2:  # ruff: ignore[magic-value-comparison]
        level = logging.DEBUG
    elif verbose >= 1:
        level = logging.INFO
    else:
        level = logging.WARNING
    logging.basicConfig(level=level, format="%(levelname)s: %(message)s", stream=sys.stderr, force=True)


def parse_job_url(job_url: str) -> tuple[str, str]:
    """Parse a job URL or ID into a base URL and job ID."""
    parsed_url = urlparse(job_url)
    if parsed_url.scheme:
        base_url = urlunparse((parsed_url.scheme, parsed_url.netloc, "", "", "", ""))
        job_id = parsed_url.path.replace("/tests/", "", 1)
    else:
        base_url = os.environ.get("OPENQA_URL", "https://openqa.opensuse.org")
        job_id = job_url
    return base_url, job_id


def _shares_failed_modules(other_job: dict[str, Any], target_modules: set[str]) -> bool:
    """Check if the given job has failures in any of the target modules."""
    other_failed = (m.get("name") for m in other_job.get("modules", []) if m.get("result") == "failed")
    return bool(target_modules.intersection(other_failed))


def _api_kind(opts: Options) -> LlmApi:
    """Resolve `auto`: Ollama's native chat endpoint ends in `/api/chat`, everything else is OpenAI style."""
    if opts.llm_api != LlmApi.AUTO:
        return opts.llm_api
    return LlmApi.OLLAMA if urlparse(opts.llm_url).path.rstrip("/").endswith("/api/chat") else LlmApi.OPENAI


def _is_claude(opts: Options) -> bool:
    return _api_kind(opts) == LlmApi.VERTEX and opts.llm_model.startswith("claude")


def _llm_payload(opts: Options, messages: list[dict[str, str]], temperature: float) -> dict[str, Any]:
    if _is_claude(opts):
        return {"anthropic_version": "vertex-2023-10-16", "max_tokens": 4096, "messages": messages}
    req: dict[str, Any] = {"model": opts.llm_model, "messages": messages}
    if _api_kind(opts) != LlmApi.OLLAMA:
        return req | {"temperature": temperature}
    options = {"temperature": temperature} | ({"num_ctx": opts.context_tokens} if opts.context_tokens else {})
    return req | {"stream": False, "options": options}


def _google_access_token(client: httpx.Client) -> str:
    """Exchange the refresh token in `GOOGLE_APPLICATION_CREDENTIALS` for an access token."""
    try:
        creds = json.loads(Path(os.environ["GOOGLE_APPLICATION_CREDENTIALS"]).read_text(encoding="utf-8"))
        data = {k: creds[k] for k in ("client_id", "client_secret", "refresh_token")} | {"grant_type": "refresh_token"}
        res = client.post("https://oauth2.googleapis.com/token", data=data)
        res.raise_for_status()
        return res.json()["access_token"]
    except (KeyError, OSError, ValueError, httpx.HTTPError):
        log.exception("Could not get a Google access token (only authorized_user credentials are supported)")
        sys.exit(1)


def _vertex_request(client: httpx.Client, token: str | None, model: str = "") -> tuple[str, str]:
    """Return the Vertex chat URL (Claude: `rawPredict`, else OpenAI-compatible) and a bearer token."""
    project = os.environ.get("GCLOUD_PROJECT") or os.environ.get("GOOGLE_CLOUD_PROJECT")
    if not project:
        log.error("Set GCLOUD_PROJECT for --llm-api=vertex")
        sys.exit(1)
    loc = os.environ.get("VERTEX_LOCATION", "global")
    host = "aiplatform.googleapis.com" if loc == "global" else f"{loc}-aiplatform.googleapis.com"
    base = f"https://{host}/v1/projects/{project}/locations/{loc}"
    url = (
        f"{base}/publishers/anthropic/models/{model}:rawPredict"
        if model.startswith("claude")
        else f"{base}/endpoints/openapi/chat/completions"
    )
    return url, token or _google_access_token(client)


def _call_llm_api(client: httpx.Client, opts: Options, messages: list[dict[str, str]], temperature: float) -> str:
    llm_url, llm_model, llm_token, timeout = opts.llm_url, opts.llm_model, opts.llm_token, opts.llm_timeout
    kind = _api_kind(opts)
    if kind == LlmApi.VERTEX:
        llm_url, llm_token = _vertex_request(client, llm_token, llm_model)
    headers = {"Authorization": f"Bearer {llm_token}"} if llm_token else {}
    try:
        res = client.post(llm_url, json=_llm_payload(opts, messages, temperature), headers=headers, timeout=timeout)
        res.raise_for_status()
        res_json = res.json()
        if _is_claude(opts):
            return res_json["content"][0]["text"]
        return res_json["message"]["content"] if kind == LlmApi.OLLAMA else res_json["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        log.exception("LLM API %s (%s) sent no usable %s chat response", llm_url, llm_model, kind)
        sys.exit(1)
    except httpx.ConnectError:
        log.exception(
            "Could not connect to LLM server at %s. Please check if the server is running"
            " or the LLM_API_URL environment variable is correct.",
            llm_url,
        )
        sys.exit(1)
    except httpx.HTTPStatusError as e:
        log.exception("LLM API %s (%s) status %d: %s", llm_url, llm_model, e.response.status_code, e.response.text)
        sys.exit(1)
    except Exception:
        log.exception("LLM API %s (%s) failed", llm_url, llm_model)
        sys.exit(1)


def _fetch_job(client: httpx.Client, base_url: str, job_id: str) -> dict[str, Any]:
    job_data = fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}/details")
    if not job_data or "job" not in job_data:
        # Fallback for openQA versions/configurations where /details might fail
        job_data = fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}")
    if job_data.get("error_status") == HTTPStatus.NOT_FOUND:
        log.info("Skipping investigation as job %s has been deleted.", job_id)
        sys.exit(0)
    if not job_data or "job" not in job_data:
        log.error("Could not retrieve job data for job %s from %s", job_id, base_url)
        sys.exit(1)
    return job_data["job"]


def _analyze(client: httpx.Client, base_url: str, job_id: str, job: dict[str, Any], opts: Options) -> str:
    """Return the failure analysis; exit when there is nothing to analyze unless forced."""
    oqa = OpenQA(client, base_url)
    softfailed = job.get("result") == "softfailed"
    try:
        return analyze_job(oqa, job_id, context_lines=opts.context_lines, include_softfailed=softfailed, job=job)
    except NoFailedModulesError as e:
        if not opts.force:
            log.info("Job %s: %s", job_id, e)
            sys.exit(0)
        return e.partial_output
    except AnalyzerError:
        log.exception("Could not analyze job %s", job_id)
        sys.exit(1)
    except Exception:
        log.exception("Unexpected error analyzing job %s", job_id)
        sys.exit(1)


def _bisect_recommended(response: str) -> bool:
    """Return True if the last `BISECT: YES|NO` verdict line of the response is YES."""
    for ln in reversed(response.splitlines()):
        if m := _BISECT_RE.match(ln):
            return m.group(1).upper() == "YES"
    return False


def _cap_lines(text: str, max_lines: int) -> tuple[str, bool]:
    """Keep the first `max_lines` lines of `text` behind an omission note; return it and whether it was cut."""
    lines = text.splitlines()
    if len(lines) <= max_lines:
        return text, False
    note = f"[... {len(lines) - max_lines} lines omitted: --log-lines cap of {max_lines} reached ...]"
    return "\n".join([*lines[:max_lines], note]) + "\n", True


def _cap_chars(text: str, max_chars: int) -> str:
    """Keep the first lines of `text` that fit into `max_chars` behind an omission note."""
    lines = text.splitlines()
    kept, used = [], 0
    for ln in lines:
        if used + len(ln) + 1 > max_chars:
            break
        kept.append(ln)
        used += len(ln) + 1
    note = f"[... {len(lines) - len(kept)} lines omitted: --context-tokens budget reached ...]"
    return "\n".join([*kept, note]) + "\n"


def _fit_context(fields: dict[str, Any], opts: Options) -> dict[str, Any]:
    """Cut the analysis so the rendered prompt plus a response reserve fits `--context-tokens` (estimated)."""
    note = CONTEXT_TRUNCATED_NOTE.format(context_tokens=opts.context_tokens)
    overhead = len(INTRO_TEMPLATE.format(**fields | {"analysis": "", "truncated": note}))
    budget = (opts.context_tokens - RESPONSE_RESERVE_TOKENS) * CHARS_PER_TOKEN - overhead - OMISSION_NOTE_CHARS
    if budget <= 0:
        log.error(
            "--context-tokens=%d leaves no room for the analysis after the prompt and %d response tokens; raise it",
            opts.context_tokens,
            RESPONSE_RESERVE_TOKENS,
        )
        sys.exit(1)
    if len(fields["analysis"]) <= budget:
        return fields
    log.info(
        "Failure analysis cut to fit --context-tokens=%d; raise it if the cut-off tail matters", opts.context_tokens
    )
    cut = _cap_chars(fields["analysis"], budget)
    return fields | {"analysis": cut, "truncated": note}


def _ask(client: httpx.Client, opts: Options, messages: list[dict[str, str]], question: str, temperature: float) -> str:
    """Append `question` to the chat, ask the LLM and keep its reply in the chat for the next question."""
    messages.append({"role": "user", "content": question})
    reply = _call_llm_api(client, opts, messages, temperature).strip()
    messages.append({"role": "assistant", "content": reply})
    return reply


def _drop_placeholder_reasons(verdict: str) -> str:
    """Strip a reason that is only the prompt's placeholder word, which small models copy verbatim."""
    return "\n".join(_PLACEHOLDER_REASON_RE.sub("", ln) for ln in verdict.splitlines())


def _enforce_bisect_rule(verdict: str, same_module_failures: int) -> str:
    """Rewrite the BISECT verdict to NO if other jobs fail in the same module; small models ignore that rule."""
    if not same_module_failures:
        return verdict
    no = f"BISECT: NO \u2014 {same_module_failures} other job(s) in this build fail in the same module"
    return "\n".join(no if _BISECT_RE.match(ln) else ln for ln in verdict.splitlines())


def _consecutive_failures(
    client: httpx.Client, base_url: str, job_id: str, job: dict[str, Any], limit: int
) -> tuple[int, bool]:
    """Count the failures in a row of the same test (name, arch, flavor) up to this job.

    Returns the failure count and whether the target job was found in the recent history.
    """
    settings = job.get("settings", {})
    params = {
        "test": job.get("test", "unknown"),
        "distri": settings.get("DISTRI", "unknown"),
        "version": settings.get("VERSION", "unknown"),
        "arch": settings.get("ARCH", "unknown"),
        "flavor": settings.get("FLAVOR", "unknown"),
        "limit": limit,
    }
    test_jobs = fetch_json(client, f"{base_url}/api/v1/jobs", params=params).get("jobs", [])
    target = int(job_id)
    job_found = any(j["id"] == target for j in test_jobs)
    if not job_found:
        log.info("Job %s not found in recent history (limit %s). Streak count may be inaccurate.", job_id, limit)
    relevant = sorted((j for j in test_jobs if j["id"] <= target), key=itemgetter("id"), reverse=True)
    relevant = [
        j for j in relevant if j.get("state") == "done" and j.get("result") in {"passed", "softfailed", "failed"}
    ]
    return next((i for i, j in enumerate(relevant) if j.get("result") != "failed"), len(relevant)), job_found


def _build_failures(client: httpx.Client, base_url: str, job_id: str, job: dict[str, Any]) -> tuple[int, int]:
    """Return the failed jobs of this build and those among them failing in the same module(s)."""
    settings = job.get("settings", {})
    params = {k.lower(): settings.get(k, "unknown") for k in ("BUILD", "DISTRI", "VERSION")} | {"result": "failed"}
    failed_jobs = fetch_json(client, f"{base_url}/api/v1/jobs", params=params).get("jobs", [])
    modules = {m.get("name", "unknown") for m in job.get("testresults", []) if m.get("result") == "failed"}
    similar = sum(1 for j in failed_jobs if str(j.get("id")) != str(job_id) and _shares_failed_modules(j, modules))
    return len(failed_jobs), similar if modules else 0


def _verdict_question(stats: dict[str, Any], opts: Options) -> str:
    hint = (
        OUTAGE_HINT.format(build_failures=stats["build_failures"])
        if stats["build_failures"] > opts.build_failure_threshold
        else ""
    )
    return VERDICT_QUESTION.format(hint=hint, **stats)


def _build_prompt(job: dict[str, Any], analysis: str, stats: dict[str, Any], opts: Options) -> str:
    settings = job.get("settings", {})
    failed_modules = [m.get("name", "unknown") for m in job.get("testresults", []) if m.get("result") == "failed"]
    extension = str(settings.get("LLM_PROMPT_EXTENSION") or "").strip()
    extension_text = f"\n\nAdditional instructions for this test:\n{extension}" if extension else ""
    analysis, truncated = _cap_lines(analysis, opts.log_lines)
    if truncated:
        log.info("Failure analysis cut to --log-lines=%d; raise it if the cut-off tail matters", opts.log_lines)
    fields = {
        "test_name": job.get("test", "unknown"),
        "failed_modules": ", ".join(failed_modules) or "unknown",
        "group": job.get("group", "unknown"),
        "build": settings.get("BUILD", "unknown"),
        "distri": settings.get("DISTRI", "unknown"),
        "version": settings.get("VERSION", "unknown"),
        "arch": settings.get("ARCH", "unknown"),
        "flavor": settings.get("FLAVOR", "unknown"),
        "result": job.get("result", "unknown"),
        "context_lines": opts.context_lines,
        "analysis": analysis,
        "truncated": TRUNCATED_NOTE.format(log_lines=opts.log_lines) if truncated else "",
        "investigation_info": stats["investigation_info"],
        "prompt_extension_text": extension_text,
    }
    return INTRO_TEMPLATE.format(**(_fit_context(fields, opts) if opts.context_tokens else fields))


def _gather_stats(
    client: httpx.Client, base_url: str, job_id: str, job: dict[str, Any], opts: Options
) -> tuple[dict[str, Any], bool]:
    """Gather failure statistics and investigation diff for the prompt."""
    build_failures, same_module_failures = _build_failures(client, base_url, job_id, job)
    consecutive_failures, job_found = _consecutive_failures(client, base_url, job_id, job, opts.history_limit)
    investigation = fetch_json(
        client, f"{base_url}/tests/{job_id}/investigation_ajax", timeout=opts.investigation_timeout
    )
    limit = opts.history_limit
    consecutive_str = (
        str(consecutive_failures)
        if job_found
        else f"{consecutive_failures} (streak count may be inaccurate: job not found in recent history, limit {limit})"
    )
    return {
        "build_failures": build_failures,
        "same_module_failures": same_module_failures,
        "consecutive_failures": consecutive_str,
        "investigation_info": redact(json.dumps(investigation.get("diff_to_last_good", "None available"))),
    }, job_found


def _perform_investigation(client: httpx.Client, base_url: str, job_id: str, opts: Options) -> None:
    comments = [] if opts.print_prompt else fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}/comments", default=[])
    if (
        not opts.force
        and isinstance(comments, list)
        and any(c.get("text", "").startswith(COMMENT_MARKER) for c in comments)
    ):
        log.info("Job %s already has an LLM investigation summary, skipping.", job_id)
        sys.exit(0)

    job = _fetch_job(client, base_url, job_id)
    if not opts.force and job.get("result") in {"passed", "softfailed"}:
        log.info("Job %s %s, skipping investigation.", job_id, job.get("result"))
        sys.exit(0)

    analysis = _analyze(client, base_url, job_id, job, opts)
    stats, job_found = _gather_stats(client, base_url, job_id, job, opts)
    if opts.print_prompt:
        prompts = [_build_prompt(job, analysis, stats, opts), BRIEF_QUESTION, _verdict_question(stats, opts)]
        typer.echo("\n\n".join(f"===== Prompt {i}/3 =====\n{p}" for i, p in enumerate(prompts, 1)))
        return
    messages: list[dict[str, str]] = []
    lines = _ask(client, opts, messages, _build_prompt(job, analysis, stats, opts), TEMPERATURE)
    brief = _ask(client, opts, messages, BRIEF_QUESTION, TEMPERATURE)
    verdict = _ask(client, opts, messages, _verdict_question(stats, opts), 0.0)
    verdict = _enforce_bisect_rule(_drop_placeholder_reasons(verdict), stats["same_module_failures"])
    llm_response = f"{lines}\n\n{brief}\n\n{verdict}"

    # Print the job URL to stdout ONLY if BISECT: YES is recommended
    # This makes the script act as a gatekeeper, similar to `openqa-label-known-issues`
    if _bisect_recommended(llm_response):
        typer.echo(f"{base_url}/tests/{job_id}")

    comment = f"{COMMENT_MARKER}\n\n{llm_response}"
    if not job_found:
        comment += (
            f"\n\n*Note: Job not found in recent history (limit {opts.history_limit}). Streak count may be inaccurate.*"
        )

    if opts.dry:
        typer.echo(comment)
    else:
        post_comment(base_url, job_id, comment)


@app.command()
def investigate(  # ruff: ignore[too-many-arguments, too-many-positional-arguments]
    job_url: str = typer.Argument(..., help="The openQA test URL or job ID for which to trigger LLM investigation"),
    verbose: Annotated[int, typer.Option("--verbose", "-v", count=True, help="Increase verbosity")] = 0,
    quiet: Annotated[bool, typer.Option("--quiet", "-q", help="Quiet mode")] = False,  # ruff: ignore[boolean-default-value-positional-argument]
    dry: Annotated[  # ruff: ignore[boolean-default-value-positional-argument]
        bool, typer.Option("--dry", help="Dry run mode: output summary instead of posting a comment")
    ] = False,
    print_prompt: Annotated[  # ruff: ignore[boolean-default-value-positional-argument]
        bool,
        typer.Option(
            "--print-prompt",
            help="Print the LLM prompts and exit: no LLM call, no comment check, nothing posted to openQA",
        ),
    ] = False,
    force: Annotated[  # ruff: ignore[boolean-default-value-positional-argument]
        bool,
        typer.Option(
            "--force",
            "-f",
            help="Force another analysis even if an LLM comment already exists or if the job passed/softfailed",
        ),
    ] = False,
    timeout: Annotated[
        int,
        typer.Option("--timeout", envvar="LLM_TIMEOUT", help="Timeout for LLM API requests in seconds"),
    ] = 600,
    retries: Annotated[
        int,
        typer.Option(
            "--retries",
            envvar="LLM_RETRIES",
            help="Number of retries on retry-worthy HTTP responses and timeouts",
        ),
    ] = 7,
    llm_url: Annotated[
        str,
        typer.Option("--llm-url", envvar="LLM_API_URL", help="URL for the LLM API endpoint"),
    ] = "http://localhost:8080/v1/chat/completions",
    llm_model: Annotated[
        str,
        typer.Option("--llm-model", envvar="LLM_MODEL", help="The LLM model to use"),
    ] = "gemma-4-26B-A4B-it",
    llm_token: Annotated[
        str | None,
        typer.Option("--llm-token", envvar="LLM_API_TOKEN", help="API token for authentication"),
    ] = None,
    context_lines: Annotated[
        int,
        typer.Option(
            "--context-lines", envvar="LLM_CONTEXT_LINES", min=0, help="Lines of log context around each failure"
        ),
    ] = 100,
    context_tokens: Annotated[
        int,
        typer.Option(
            "--context-tokens",
            envvar="LLM_CONTEXT_TOKENS",
            min=0,
            help="Context size of the model in tokens (0: unlimited); the analysis is cut to fit,"
            " and sent as num_ctx to Ollama (/api/chat)",
        ),
    ] = 0,
    llm_api: Annotated[
        LlmApi,
        typer.Option(
            "--llm-api",
            envvar="LLM_API",
            help="Chat API flavour; auto selects ollama for URLs ending in /api/chat, else openai."
            " vertex uses GOOGLE_APPLICATION_CREDENTIALS, GCLOUD_PROJECT, VERTEX_LOCATION (default global)",
        ),
    ] = LlmApi.AUTO,
    log_lines: Annotated[
        int,
        typer.Option(
            "--log-lines",
            envvar="LLM_LOG_LINES",
            min=0,
            help="Maximum lines of failure analysis sent to the LLM (formerly the autoinst log tail length)",
        ),
    ] = 500,
    history_limit: Annotated[
        int,
        typer.Option("--history-limit", envvar="LLM_HISTORY_LIMIT", help="Limit for consecutive failure lookup"),
    ] = 100,
    build_failure_threshold: Annotated[
        int,
        typer.Option(
            "--build-failure-threshold",
            envvar="LLM_BUILD_FAILURE_THRESHOLD",
            help="Threshold for infrastructure outage hint",
        ),
    ] = 20,
    openqa_timeout: Annotated[
        float,
        typer.Option(
            "--openqa-timeout",
            envvar=["OPENQA_HTTP_TIMEOUT_S"],
            help="Timeout for openQA HTTP requests in seconds",
        ),
    ] = DEFAULT_OPENQA_TIMEOUT,
    investigation_timeout: Annotated[
        float,
        typer.Option(
            "--investigation-timeout",
            envvar=["OPENQA_INVESTIGATION_TIMEOUT_S"],
            help="Timeout for investigation_ajax HTTP requests in seconds",
        ),
    ] = DEFAULT_INVESTIGATION_TIMEOUT,
) -> None:
    """CLI entry point to investigate a failed openQA job."""
    setup_logging(verbose, quiet=quiet)
    base_url, job_id = parse_job_url(job_url)

    if not job_id.isdigit():
        log.error("Invalid job ID: %s", job_id)
        sys.exit(1)

    opts = Options(
        llm_url=llm_url,
        llm_model=llm_model,
        llm_token=llm_token,
        llm_timeout=timeout,
        context_lines=context_lines,
        log_lines=log_lines,
        history_limit=history_limit,
        build_failure_threshold=build_failure_threshold,
        context_tokens=context_tokens,
        llm_api=llm_api,
        investigation_timeout=investigation_timeout,
        force=force,
        dry=dry,
        print_prompt=print_prompt,
    )
    transport = RetryTransport(retries=retries)
    with httpx.Client(transport=transport, headers={"User-Agent": USER_AGENT}, timeout=openqa_timeout) as client:
        _perform_investigation(client, base_url, job_id, opts)



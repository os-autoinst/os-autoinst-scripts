HTTP_NOT_FOUND = 404
USER_AGENT = "openqa-investigate (https://github.com/os-autoinst/os-autoinst-scripts)"
DEFAULT_HTTP_TIMEOUT: float = 90.0
DEFAULT_INVESTIGATION_TIMEOUT: float = 900.0
# Characters allowed by openQA in TEST variable: '\p{Word} _*.,:/#@'
TEST_NAME_INVALID_CHARS = re.compile(r"[^\w _*.,:/#@]")

log = logging.getLogger("openqa-investigate")


def setup_logging(verbose: int) -> None:
    level_map = {
        0: logging.WARNING,
        1: logging.INFO,
        2: logging.DEBUG,
    }
    level = level_map.get(min(verbose, 2), logging.WARNING)
    logging.basicConfig(level=level, format="%(levelname)s: %(message)s", stream=sys.stderr, force=True)


def format_mode(*, strict: bool) -> str:
    """Return 'strict' or 'non-strict' based on the boolean flag."""
    return "strict" if strict else "non-strict"


class TransientHTTPError(Exception):
    """Exception raised for HTTP responses with transient status codes."""

    def __init__(self, response: httpx.Response) -> None:
        """Initialize the exception with the HTTP response."""
        super().__init__(f"HTTP {response.status_code}")
        self.response = response


class RetryTransport(httpx.HTTPTransport):
    """Custom HTTP transport that retries on transient errors (e.g. 429, 5xx)."""

    RETRY_STATUS_CODES = frozenset({408, 429, 500, 502, 503, 504})

    def __init__(self, retries: int = 1, **kwargs: Any) -> None:  # ruff: ignore[any-type]
        """Initialize the RetryTransport with a configurable number of retries."""
        super().__init__(**kwargs)
        self.retries = retries

    @staticmethod
    def _now() -> dt.datetime:
        return dt.datetime.now(dt.UTC)

    def _check_and_raise(self, response: httpx.Response) -> None:
        if response.status_code in self.RETRY_STATUS_CODES:
            raise TransientHTTPError(response)

    def _wait_strategy(self, retry_state: tenacity.RetryCallState) -> float:
        exc = retry_state.outcome.exception()
        if not isinstance(exc, TransientHTTPError):
            return 0.0
        response = exc.response
        retry_after = response.headers.get("Retry-After")
        delay = 0.0
        if retry_after:
            try:
                delay = float(retry_after)
            except ValueError:
                try:
                    retry_dt = parsedate_to_datetime(retry_after)
                    delay = (retry_dt - self._now()).total_seconds()
                except (TypeError, ValueError) as e:
                    log.debug("Failed to parse Retry-After header as date: %s", e)

        if delay <= 0.0:
            delay = float(2 ** (retry_state.attempt_number - 1))

        return delay

    def _before_sleep(self, retry_state: tenacity.RetryCallState) -> None:
        exc = retry_state.outcome.exception()
        if isinstance(exc, TransientHTTPError):
            response = exc.response
            response.close()

            retries_left = self.retries - retry_state.attempt_number
            delay = retry_state.next_action.sleep

            log.info(
                "Received HTTP %d. Retrying in %.2f seconds (%d retries left)...",
                response.status_code,
                delay,
                retries_left,
            )

    def handle_request(self, request: httpx.Request) -> httpx.Response:
        """Handle the HTTP request, retrying on transient status codes if retries are available."""
        try:
            for attempt in tenacity.Retrying(
                retry=tenacity.retry_if_exception_type(TransientHTTPError),
                stop=tenacity.stop_after_attempt(self.retries + 1),
                wait=self._wait_strategy,
                before_sleep=self._before_sleep,
                reraise=True,
            ):
                with attempt:
                    response = super().handle_request(request)
                    self._check_and_raise(response)
        except TransientHTTPError as e:
            return e.response

        return response


class OpenQAClient:
    """A client for interacting with openQA API and front-end endpoints."""

    def __init__(  # ruff: ignore[too-many-arguments]
        self,
        host_url: str,
        retries: int = 3,
        retry_sleep_time: int = 20,
        *,
        dry_run: bool = False,
        http_timeout: float = DEFAULT_HTTP_TIMEOUT,
        investigation_timeout: float = DEFAULT_INVESTIGATION_TIMEOUT,
        strict: bool = False,
    ) -> None:
        self.host_url = host_url.rstrip("/")
        self.retries = retries
        self.retry_sleep_time = retry_sleep_time
        self.dry_run = dry_run
        self.http_timeout = http_timeout
        self.investigation_timeout = investigation_timeout
        self.strict = strict

    def _run_openqa_cli(self, args: list[str], *, mutate: bool = False) -> dict[str, Any] | list[dict[str, Any]]:
        cmd = [
            "openqa-cli",
            "api",
            "--header",
            f"User-Agent: {USER_AGENT}",
            "--host",
            self.host_url,
            "--retries",
            str(self.retries),
            *args,
        ]
        cmd_str = " ".join(cmd)
        if mutate and self.dry_run:
            log.info("[DRY-RUN] Would execute: %s", cmd_str)
            return {"dry_run": True}

        log.debug("Executing: %s", cmd_str)

        try:
            res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        except subprocess.CalledProcessError as e:
            log.exception("Error executing openqa-cli: %s", e.stderr)
            raise

        stdout = res.stdout.strip()
        if not stdout:
            return {}
        try:
            res_json = json.loads(stdout)
        except json.JSONDecodeError:
            return {"raw_output": stdout}

        if isinstance(res_json, (dict, list)):
            return res_json
        return {"raw_output": stdout}

    def _get_http(self, path: str, *, timeout: float | None = None) -> dict[str, Any]:
        if self.retries < 0:
            return {}
        url = f"{self.host_url}/{path.lstrip('/')}"
        log.debug("HTTP GET: %s", url)

        headers = {"User-Agent": USER_AGENT}
        req_timeout = timeout if timeout is not None else self.http_timeout
        transport = RetryTransport(retries=self.retries)

        try:
            with httpx.Client(
                transport=transport,
                headers=headers,
                follow_redirects=True,
                timeout=req_timeout,
            ) as client:
                response = client.get(url)
                response.raise_for_status()
                res_json = response.json()
                if isinstance(res_json, dict):
                    return res_json
                return {"data": res_json}
        except Exception:
            log.exception("HTTP GET failed after %d attempts", self.retries + 1)
            raise

    def get_job_status(self, job_id: int) -> dict[str, Any]:
        args = ["--json", f"experimental/jobs/{job_id}/status"]
        res = self._run_openqa_cli(args)
        if isinstance(res, dict):
            return res
        return {}

    def get_job(self, job_id: int) -> dict[str, Any]:
        args = ["--json", f"jobs/{job_id}"]
        res = self._run_openqa_cli(args)
        if isinstance(res, dict):
            return res
        return {}

    def get_job_comments(self, job_id: int) -> list[dict[str, Any]]:
        args = ["--json", f"jobs/{job_id}/comments"]
        res = self._run_openqa_cli(args)
        if isinstance(res, list):
            return res
        return []

    def post_job_comment(self, job_id: int, text: str) -> dict[str, Any]:
        args = ["-X", "POST", f"jobs/{job_id}/comments", f"text={text}"]
        res = self._run_openqa_cli(args, mutate=True)
        if isinstance(res, dict):
            return res
        return {}

    def put_job_comment(self, job_id: int, comment_id: int, text: str) -> dict[str, Any]:
        args = ["-X", "PUT", f"jobs/{job_id}/comments/{comment_id}", f"text={text}"]
        res = self._run_openqa_cli(args, mutate=True)
        if isinstance(res, dict):
            return res
        return {}

    def delete_job_comment(self, job_id: int, comment_id: int) -> dict[str, Any]:
        args = ["-X", "DELETE", f"jobs/{job_id}/comments/{comment_id}"]
        res = self._run_openqa_cli(args, mutate=True)
        if isinstance(res, dict):
            return res
        return {}

    def put_job_priority(self, job_id: int, priority: int) -> dict[str, Any]:
        args = ["--json", "--data", f'{{"priority": {priority}}}', "-X", "PUT", f"jobs/{job_id}"]
        res = self._run_openqa_cli(args, mutate=True)
        if isinstance(res, dict):
            return res
        return {}

    def get_dependencies_ajax(self, job_id: int) -> dict[str, Any]:
        try:
            return self._get_http(f"tests/{job_id}/dependencies_ajax")
        except httpx.HTTPError:
            log.debug("HTTP GET failed, falling back to openqa-cli for dependencies_ajax")
            res = self._run_openqa_cli(["-X", "GET", f"tests/{job_id}/dependencies_ajax"])
            if isinstance(res, dict):
                return res
            return {}

    def get_investigation_ajax(self, job_id: int, *, strict: bool | None = None) -> dict[str, Any]:
        use_strict = self.strict if strict is None else strict
        path = f"tests/{job_id}/investigation_ajax?strict={'1' if use_strict else '0'}"
        return self._get_http(path, timeout=self.investigation_timeout)

    def get_vars_json(self, job_id: int) -> dict[str, Any]:
        return self._get_http(f"tests/{job_id}/file/vars.json")


def clone_job(
    host_url: str,
    job_id: int,
    clone_settings: list[str],
    *,
    dry_run: bool = False,
) -> dict[str, Any]:
    cmd = [
        "openqa-clone-job",
        "--json-output",
        "--skip-chained-deps",
        "--max-depth",
        "0",
        "--parental-inheritance",
        "--within-instance",
        f"{host_url.rstrip('/')}/tests/{job_id}",
        *clone_settings,
    ]
    cmd_str = " ".join(cmd)

    if dry_run:
        log.info("[DRY-RUN] Would execute: %s", cmd_str)
        return {str(job_id): 42}

    log.debug("Executing: %s", cmd_str)

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        log.exception("Error executing openqa-clone-job: %s", e.stderr)
        raise

    stdout = res.stdout.strip()
    try:
        res_json = json.loads(stdout)
    except json.JSONDecodeError:
        return {"raw_output": stdout}

    if isinstance(res_json, dict):
        return res_json
    return {"raw_output": stdout}


def parse_job_url(job_url: str, _default_scheme: str, _default_host: str) -> tuple[int, str, str]:
    parsed = urlparse(job_url)
    if parsed.scheme and parsed.netloc:
        scheme = parsed.scheme
        host = parsed.netloc
        path_parts = [p for p in parsed.path.strip("/").split("/") if p]
        if not path_parts:
            msg = f"Could not extract job ID from URL path: {parsed.path}"
            raise ValueError(msg)
        job_str = path_parts[-1]
        if job_str.startswith("t") and job_str[1:].isdigit():
            job_id = int(job_str[1:])
        elif job_str.isdigit():
            job_id = int(job_str)
        else:
            msg = f"Could not extract numeric job ID from URL path component: {job_str}"
            raise ValueError(msg)
        return job_id, scheme, host
    msg = f"Invalid job URL: {job_url}"
    raise ValueError(msg)


def get_cluster_jobs(dep_data: dict[str, Any], job_id: int) -> set[int]:
    """Get all job IDs in the same cluster."""
    raw = dep_data.get("cluster") or ()
    clusters = raw.values() if isinstance(raw, dict) else raw
    return {job_id}.union(*(c for c in clusters if job_id in c))


def query_dependency_data_or_postpone(client: OpenQAClient, job_id: int) -> dict[str, Any]:
    """Query dependency AJAX data or postpone if cluster is not done."""
    dep_data = client.get_dependencies_ajax(job_id)
    if not dep_data:
        return {}

    cluster_jobs = get_cluster_jobs(dep_data, job_id)

    pending_count = 0
    if "nodes" in dep_data:
        for node in dep_data["nodes"]:
            if node.get("id") in cluster_jobs and node.get("state") not in {"done", "cancelled"}:
                pending_count += 1

    if pending_count > 0:
        log.info(
            "Postponing to investigate job %s: waiting until %s pending parallel job(s) finished", job_id, pending_count
        )
        raise typer.Exit(code=142)

    return dep_data


def sync_via_investigation_comment(
    client: OpenQAClient,
    job_id: int,
    first_cluster_job_id: int,
    *,
    force: bool = False,
) -> str | None:
    """Synchronize investigation start via comment."""
    if client.dry_run:
        return None

    mode_str = format_mode(strict=client.strict)
    post_res = client.post_job_comment(
        first_cluster_job_id, f"Starting investigation for job {job_id} ({mode_str} mode)"
    )
    comment_id = post_res.get("id")
    if comment_id is None:
        return None
    comment_id = int(comment_id)

    comments = client.get_job_comments(first_cluster_job_id)
    inv_comments = [c for c in comments if "investigation" in c.get("text", "")]
    if not inv_comments:
        return str(comment_id)

    first_comment_id = min(int(c["id"]) for c in inv_comments if "id" in c)

    if comment_id != first_comment_id and not force:
        log.info(
            "Skipping investigation of job %s: job cluster is already being investigated, see comment on job %s",
            job_id,
            first_cluster_job_id,
        )
        client.delete_job_comment(first_cluster_job_id, comment_id)
        raise typer.Exit(code=0)

    return str(comment_id)


def finalize_investigation_comment(
    client: OpenQAClient,
    job_id: int,
    first_cluster_job_id: int,
    comment_id: str,
    comment_text: str,
) -> None:
    """Finalize or delete the investigation comment."""
    if not comment_text:
        client.delete_job_comment(first_cluster_job_id, comment_id)
        return

    mode_str = format_mode(strict=client.strict)
    comment = (
        f"Automatic investigation jobs for job {job_id} ({mode_str} mode):\n\n"
        f"{comment_text}\n\n"
        "💡[*Detailed explanation of this comment*]"
        "(https://github.com/os-autoinst/os-autoinst-scripts#More-details-and-examples-about-openqa-investigate-comments)"
    )
    client.put_job_comment(first_cluster_job_id, comment_id, comment)

    if str(first_cluster_job_id) != str(job_id):
        client.post_job_comment(job_id, comment)


def _check_clone_prerequisites(job_info: dict[str, Any], job_id: int) -> None:
    """Check if the job can be cloned and raise exit if not."""
    chained_children = len(job_info.get("children", {}).get("Directly chained", []))
    chained_parents = len(job_info.get("parents", {}).get("Directly chained", []))
    if chained_children + chained_parents > 0:
        log.error("Unable to clone job %s: it is part of a directly chained cluster (not supported)", job_id)
        raise typer.Exit(code=2)


def _prepare_refspec_settings(  # ruff: ignore[too-many-arguments, too-many-positional-arguments]
    client: OpenQAClient,
    origin: int,
    base_name: str,
    name_suffix: str,
    refspec: str,
    casedir: str | None,
) -> tuple[list[str], str]:
    """Prepare settings related to refspec and returns settings and updated name."""
    settings = []
    name_ext = ""
    vars_json = client.get_vars_json(origin)
    testgiturl = vars_json.get("TEST_GIT_URL")

    if testgiturl:
        if not testgiturl.startswith(("http://", "https://")) or " " in testgiturl:
            log.info(
                "Can not clone refspec of job %s with unknown/invalid git url TEST_GIT_URL='%s'", origin, testgiturl
            )
            return ["INVALID_URL"], name_ext
        casedir = testgiturl

    casedir = casedir or "https://github.com/os-autoinst/os-autoinst-distri-opensuse.git"
    repo_base = casedir.split("#")[0]
    settings.append(f"CASEDIR={repo_base}#{refspec}")

    if "last_good_tests_and_build" in name_suffix:
        worker_vars = vars_json.get("WORKER_CLASS")
        if worker_vars:
            settings.append(f"WORKER_CLASS:{base_name}={worker_vars}")
        else:
            name_ext = "(unidentified worker class in vars.json)"

    return settings, name_ext


def _build_clone_settings(  # ruff: ignore[too-many-arguments, too-many-positional-arguments]
    client: OpenQAClient,
    job_info: dict[str, Any],
    origin: int,
    name_suffix: str,
    refspec: str | None,
    extra_settings: list[str] | None,
    investigation_gid: int,
    *,
    strict: bool = False,
) -> tuple[list[str], str]:
    """Build clone settings and the full job name."""
    base_name = job_info.get("test", "")
    name_suffix = TEST_NAME_INVALID_CHARS.sub("", name_suffix)
    suffix_str = f":{name_suffix}" if name_suffix else ""
    name = f"{base_name}:investigate{suffix_str}"

    settings = [
        "_TRIGGER_JOB_DONE_HOOK=1",
        f"_GROUP_ID={investigation_gid}",
        "BUILD=",
    ]

    if refspec:
        ref_settings, name_ext = _prepare_refspec_settings(
            client, origin, base_name, name_suffix, refspec, job_info.get("settings", {}).get("CASEDIR")
        )
        if "INVALID_URL" in ref_settings:
            return [], ""
        settings.extend(ref_settings)
        name += name_ext

    settings.append(f"TEST+=:investigate{suffix_str}")
    if extra_settings:
        settings.extend(extra_settings)

    settings.extend(f"{k}=none" for k in job_info.get("settings", {}) if k.startswith("PUBLISH_"))

    settings.append(f"OPENQA_INVESTIGATE_ORIGIN={client.host_url}/t{origin}")
    if strict:
        settings.append("OPENQA_INVESTIGATE_STRICT=1")
    return settings, name


def clone(  # ruff: ignore[too-many-arguments, too-many-positional-arguments]
    client: OpenQAClient,
    origin: int,
    job_id: int,
    name_suffix: str,
    refspec: str | None,
    extra_settings: list[str] | None,
    investigation_gid: int,
    prio_add: int,
    *,
    strict: bool = False,
) -> str:
    """Clone an openQA job with bisection criteria."""
    clone_job_data = client.get_job(job_id)
    if not clone_job_data or "job" not in clone_job_data:
        log.error("Error: unable to query job data for %s", job_id)
        raise typer.Exit(code=1)

    job_info = clone_job_data.get("job", {})
    _check_clone_prerequisites(job_info, job_id)

    base_prio_str = job_info.get("priority")
    base_prio = int(base_prio_str) if base_prio_str is not None else None

    settings, name = _build_clone_settings(
        client, job_info, origin, name_suffix, refspec, extra_settings, investigation_gid, strict=strict
    )
    if not settings and refspec:
        return ""

    out = clone_job(client.host_url, job_id, settings, dry_run=client.dry_run)
    clone_id = out.get(str(job_id))

    result_line = f"* *{name}*: t#{clone_id}"

    if base_prio is not None:
        for c_id in out.values():
            if isinstance(c_id, (int, str)) and str(c_id).isdigit():
                client.put_job_priority(int(c_id), base_prio + prio_add)

    return result_line


def _trigger_regression_jobs(  # ruff: ignore[too-many-arguments, too-many-positional-arguments]
    client: OpenQAClient,
    job_id: int,
    last_good: int,
    investigation: dict[str, Any],
    extra_settings: list[str] | None,
    investigation_gid: int,
    prio_add: int,
    lines: list[str],
    *,
    strict: bool = False,
) -> None:
    """Trigger the regression jobs."""

    def append_clone(res: str) -> None:
        if res:
            lines.append(res)

    test_log = investigation.get("test_log", "")
    last_good_tests = ""
    refspec_arg = None
    vars_last_good = {}

    if re.search(r"No.*changes recorded", test_log):
        log.info("%s. Skipping test regression investigation job.", test_log)
    else:
        vars_last_good = client.get_vars_json(last_good)
        last_good_tests = vars_last_good.get("TEST_GIT_HASH", "")
        refspec_arg = last_good_tests
        append_clone(
            clone(
                client,
                job_id,
                job_id,
                f"last_good_tests:{last_good_tests}",
                refspec_arg,
                extra_settings,
                investigation_gid,
                prio_add,
                strict=strict,
            )
        )

    last_good_build = ""
    inv_str = json.dumps(investigation)
    if "BUILD" not in inv_str:
        log.info(
            "Current job has same build as last good, product regression unlikely. "
            "Skipping product regression investigation job."
        )
    else:
        if not vars_last_good:
            vars_last_good = client.get_vars_json(last_good)
        last_good_build = vars_last_good.get("BUILD", "")
        append_clone(
            clone(
                client,
                job_id,
                last_good,
                f"last_good_build:{last_good_build}",
                None,
                extra_settings,
                investigation_gid,
                prio_add,
                strict=strict,
            )
        )

    if not last_good_tests:
        log.info(
            "No test regression expected. Not triggered 'good build+test' "
            "as it would be the same as 3., good build + current test"
        )
    elif not last_good_build:
        log.info(
            "No product regression expected. Not triggered 'good build+test' "
            "as it would be the same as 2., current build + good test"
        )
    else:
        append_clone(
            clone(
                client,
                job_id,
                last_good,
                f"last_good_tests_and_build:{last_good_tests}+{last_good_build}",
                refspec_arg,
                extra_settings,
                investigation_gid,
                prio_add,
                strict=strict,
            )
        )


def trigger_jobs(
    client: OpenQAClient,
    job_id: int,
    extra_settings: list[str] | None,
    investigation_gid: int,
    prio_add: int,
) -> str:
    """Trigger standard retry job and regression jobs."""
    lines = []

    res = clone(
        client, job_id, job_id, "retry", None, extra_settings, investigation_gid, prio_add, strict=client.strict
    )
    if res:
        lines.append(res)

    investigation = client.get_investigation_ajax(job_id)
    last_good_obj = investigation.get("last_good")
    if not last_good_obj or last_good_obj == "not found":
        log.info("No last good recorded, skipping regression investigation jobs")
        return "\n".join(lines)

    last_good = last_good_obj.get("text")
    if not last_good or not str(last_good).isdigit():
        log.error(".last_good.text not found: investigation for test %s returned '%s'", job_id, investigation)
        return "\n".join(lines)

    last_good_id = int(last_good)
    _trigger_regression_jobs(
        client,
        job_id,
        last_good_id,
        investigation,
        extra_settings,
        investigation_gid,
        prio_add,
        lines,
        strict=client.strict,
    )
    return "\n".join(lines)


def _should_exclude_job(
    job_info: dict[str, Any],
    old_name: str,
    exclude_name_regex: str,
    exclude_group_regex: str,
    *,
    exclude_no_group: bool = True,
) -> bool:
    """Return True if job should be excluded from investigation."""
    if re.search(exclude_name_regex, old_name):
        log.info("Job name '%s' matches $exclude_name_regex '%s', skipping investigation", old_name, exclude_name_regex)
        return True

    parent_group = job_info.get("parent_group") or ""
    group = job_info.get("group") or ""
    group_str = f"{parent_group} / {group}"

    if group_str == " / " and exclude_no_group:
        log.info("Job w/o job group, $exclude_no_group is set, skipping investigation")
        return True

    if re.search(exclude_group_regex, group_str):
        log.info(
            "Job group '%s' matches $exclude_group_regex '%s', skipping investigation",
            group_str,
            exclude_group_regex,
        )
        return True

    user_unset = job_info.get("settings", {}).get("NO_INVESTIGATION")
    if user_unset is not None and str(user_unset) == "1":
        log.info("NO_INVESTIGATION=1 detected, skipping")
        return True

    return False


def _find_investigation_comment(comments: list[dict[str, Any]]) -> dict[str, Any] | None:
    target_comment = None
    min_id = float("inf")
    for comment in comments:
        text = comment.get("text", "")
        if "Automatic investigation jobs" not in text or "for job" not in text:
            continue
        if ":investigate:retry*:" not in text:
            continue
        c_id_str = comment.get("id")
        if c_id_str is not None:
            comment_id = int(c_id_str)
            if comment_id < min_id:
                min_id = comment_id
                target_comment = comment
    return target_comment


def fetch_investigation_results(client: OpenQAClient, origin_job_id: int) -> list[tuple[str, int, str]]:
    """Fetch results of all sub-jobs from the investigation comment."""
    if client.dry_run:
        return []

    comments = client.get_job_comments(origin_job_id)
    target_comment = _find_investigation_comment(comments)

    if not target_comment:
        return []

    results = []
    text = target_comment.get("text", "")
    for line in text.splitlines():
        match = re.search(r":investigate:([^:*]+).*t\#([0-9]+)", line)
        if match:
            inv_type = match.group(1)
            other_id = int(match.group(2))

            job_status_data = client.get_job_status(other_id)
            state = job_status_data.get("state")
            if state not in {"done", "cancelled"}:
                log.info("Investigation job %s is not finished (state: %s)", other_id, state)
                raise typer.Exit(code=142)

            result = job_status_data.get("result", "")
            results.append((inv_type, other_id, result))

    return results


def identify_issue_type(results: list[tuple[str, int, str]]) -> tuple[bool, bool, bool, bool]:
    """Identify the issue type based on investigation results."""
    product_issue = False
    test_issue = False
    infra_issue = False

    pass_lgtb: bool | None = None
    pass_lgb: bool | None = None
    pass_lgt: bool | None = None

    for inv_type, _, result in results:
        if result in {"none", "skipped", "user_cancelled", "user_restarted", "parallel_restarted"}:
            return False, False, False, True

        passed = result in {"passed", "softfailed"}
        if inv_type == "last_good_tests_and_build":
            pass_lgtb = passed
        elif inv_type == "last_good_build":
            pass_lgb = passed
        elif inv_type == "last_good_tests":
            pass_lgt = passed

    cond_prod = (pass_lgtb is not False) and (pass_lgt is not True) and (pass_lgb is True)
    cond_test = (pass_lgtb is not False) and (pass_lgt is True) and (pass_lgb is not True)
    cond_infra = (pass_lgtb is False) and (pass_lgt is False) and (pass_lgb is False)

    if cond_prod:
        product_issue = True
    elif cond_test:
        test_issue = True
    elif cond_infra:
        infra_issue = True

    return product_issue, test_issue, infra_issue, False


def _verify_retry_job(client: OpenQAClient, retry_name: str, job_id: int, origin_url: str) -> tuple[int, bool]:
    if not origin_url:
        return 0, False

    match = re.search(r"/t(\d+)$", origin_url)
    if not match:
        return 0, False
    origin_job_id = int(match.group(1))

    origin_job_data = client.get_job(origin_job_id)
    if not origin_job_data or origin_job_data.get("error_status") == HTTP_NOT_FOUND:
        log.info(
            "Skipping posting investigation comment on original job %s as it does not exist anymore", origin_job_id
        )
        return 0, False

    origin_name = origin_job_data.get("job", {}).get("test", "")
    if retry_name != f"{origin_name}:investigate:retry":
        log.info("Job %s (%s) is not a retry of %s (%s)", retry_name, job_id, origin_name, origin_job_id)
        return 0, False

    return origin_job_id, True


def _build_investigation_comment(  # ruff: ignore[too-many-arguments, too-many-positional-arguments]
    client: OpenQAClient,
    job_id: int,
    retry_name: str,
    retry_result: str,
    settings: dict[str, Any],
    origin_job_id: int,
    *,
    strict: bool = False,
) -> str:
    mode_str = format_mode(strict=strict)
    comment = f"Investigate retry job *{retry_name}* ({mode_str} mode): t#{job_id}"

    if retry_result in {"passed", "softfailed"}:
        comment += f" {retry_result}.\n\n📋 **Likely a sporadic failure**."
        force_status = settings.get("_FORCE_STATUS_ON_RETRY")
        if force_status is not None and str(force_status).isdigit() and int(force_status) > 0:
            comment += f"\nlabel:force_result:{retry_result}:retry_job_{retry_result}"
        return comment

    results = fetch_investigation_results(client, origin_job_id)
    product_issue, test_issue, infra_issue, cancelled = identify_issue_type(results)

    if cancelled:
        return comment + " cancelled.\n\n"

    comment += " failed.\n\n"
    if product_issue:
        comment += "📋 **Jobs including the last good build are ok, likely a product issue**."
    elif test_issue:
        comment += "📋 **Jobs including the last good test are ok, likely a test issue**."
    elif infra_issue:
        comment += (
            "📋 **All investigation jobs failed, likely an issue with the test environment "
            "(settings, external resources, infrastructure)**."
        )
    else:
        comment += "📋 **Likely not a sporadic failure**."

    return comment


def post_investigate(
    client: OpenQAClient,
    job_id: int,
    retry_name: str,
    job_data: dict[str, Any],
    *,
    strict: bool | None = None,
) -> None:
    """Handle investigation logic when the current job is the retry job."""
    if not retry_name.endswith("investigate:retry"):
        log.info("Job is ':investigate:' already, skipping investigation")
        return

    job_info = job_data.get("job", {})
    retry_result = job_info.get("result", "")
    settings = job_info.get("settings", {})
    origin_url = settings.get("OPENQA_INVESTIGATE_ORIGIN", "")

    origin_job_id, proceed = _verify_retry_job(client, retry_name, job_id, origin_url)
    if not proceed:
        return

    is_strict = client.strict if strict is None else strict
    if not is_strict:
        setting_strict = settings.get("OPENQA_INVESTIGATE_STRICT")
        if setting_strict is not None:
            is_strict = str(setting_strict) == "1"

    log.info(
        "Processing retry job %s for origin %s (mode: %s)",
        job_id,
        origin_job_id,
        format_mode(strict=is_strict),
    )

    comment = _build_investigation_comment(
        client, job_id, retry_name, retry_result, settings, origin_job_id, strict=is_strict
    )

    out = client.post_job_comment(origin_job_id, comment)
    if out.get("error_status") == HTTP_NOT_FOUND:
        pass
    elif "error" in out or out.get("error_status"):
        log.error(
            "Unexpected error encountered when posting comments on job %s after investigation job %s failed: '%s'",
            origin_job_id,
            job_id,
            out,
        )
        raise typer.Exit(code=2)


def run_investigation_logic(  # ruff: ignore[too-many-arguments, complex-structure]
    client: OpenQAClient,
    job_id: int,
    *,
    extra_settings: list[str] | None = None,
    investigation_gid: int = 0,
    prio_add: int = 100,
    exclude_name_regex: str = ":investigate:",
    exclude_no_group: bool = True,
    exclude_group_regex: str = "Development.*/ ",
    force: bool = False,
    strict: bool | None = None,
) -> None:
    """Run core investigation and bisection logic."""
    if strict is not None:
        client.strict = strict

    job_data = client.get_job(job_id)
    if not job_data or "job" not in job_data:
        log.error("Error: unable to query job data for %s", job_id)
        raise typer.Exit(code=1)

    job_info = job_data.get("job", {})
    old_name = job_info.get("test", "")

    if ":investigate:" in old_name:
        post_investigate(client, job_id, old_name, job_data, strict=strict)
        return

    mode_str = format_mode(strict=client.strict)
    log.info("Investigating job %s (%s mode)", job_id, mode_str)

    clone_id = job_info.get("clone_id")
    if not force and clone_id is not None:
        log.info(
            "Job %s already has a clone, skipping investigation. "
            "Use the env variable 'force=true' to trigger investigation jobs",
            job_id,
        )
        return

    dep_data = query_dependency_data_or_postpone(client, job_id)

    cluster = get_cluster_jobs(dep_data, job_id)
    first_cluster_job_id = min(cluster)

    if _should_exclude_job(
        job_info, old_name, exclude_name_regex, exclude_group_regex, exclude_no_group=exclude_no_group
    ):
        return

    comment_id_str = sync_via_investigation_comment(client, job_id, first_cluster_job_id, force=force)

    try:
        out = trigger_jobs(client, job_id, extra_settings, investigation_gid, prio_add)
    except typer.Exit:
        raise
    except Exception as e:
        err_msg = str(e)
        if "will fail" in err_msg and "repositories" in err_msg and "unavailable" in err_msg:
            log.warning("Ignoring known error when triggering job %s: '%s'", job_id, err_msg)
            rc = 0
        else:
            log.exception("Unexpected error encountered when triggering job %s: '%s'", job_id, err_msg)
            rc = 1

        if comment_id_str:
            client.put_job_comment(
                first_cluster_job_id, comment_id_str, f"Triggering investigation jobs failed: {err_msg}"
            )

        raise typer.Exit(code=rc) from e

    if out:
        sys.stdout.write(f"{out}\n")
    log.debug("openqa-investigate, id: '%s', mode: '%s', out: '%s'", job_id, mode_str, out)

    if comment_id_str:
        finalize_investigation_comment(client, job_id, first_cluster_job_id, comment_id_str, out)


app = typer.Typer(add_completion=False)


@app.command()
def main(  # ruff: ignore[too-many-arguments]
    job_id: Annotated[
        str,
        typer.Argument(
            ...,
            help="The job ID or full openQA test URL (e.g., https://openqa.opensuse.org/tests/1234).",
        ),
    ],
    extra_settings: Annotated[
        list[str] | None,
        typer.Argument(help="Extra clone parameters (e.g. key=value) to pass to openqa-clone-job."),
    ] = None,
    *,
    host: Annotated[
        str,
        typer.Option(
            envvar="host",
            help="openQA host domain.",
        ),
    ] = "openqa.opensuse.org",
    scheme: Annotated[
        str,
        typer.Option(
            envvar="scheme",
            help="URL scheme (http or https).",
        ),
    ] = "https",
    investigation_gid: Annotated[
        int,
        typer.Option(
            envvar="investigation_gid",
            help="Group ID for investigated jobs.",
        ),
    ] = 0,
    dry_run: Annotated[
        bool,
        typer.Option(
            envvar="dry_run",
            help="Perform a dry run without making modifying API requests.",
        ),
    ] = False,
    verbose: Annotated[
        int,
        typer.Option(
            "--verbose",
            "-v",
            count=True,
            help="Increase verbosity.",
        ),
    ] = 0,
    prio_add: Annotated[
        int,
        typer.Option(
            envvar="prio_add",
            help="Priority added to cloned jobs.",
        ),
    ] = 100,
    exclude_name_regex: Annotated[
        str,
        typer.Option(
            envvar="exclude_name_regex",
            help="Exclude jobs matching this name pattern.",
        ),
    ] = ":investigate:",
    exclude_no_group: Annotated[
        bool,
        typer.Option(
            envvar="exclude_no_group",
            help="Exclude jobs that do not belong to any group.",
        ),
    ] = True,
    exclude_group_regex: Annotated[
        str,
        typer.Option(
            envvar="exclude_group_regex",
            help="Exclude jobs in groups matching this pattern.",
        ),
    ] = "Development.*/ ",
    force: Annotated[
        bool,
        typer.Option(
            envvar="force",
            help="Force running investigations even if already done.",
        ),
    ] = False,
    strict: Annotated[
        bool,
        typer.Option(
            "--strict/--no-strict",
            envvar=["OPENQA_INVESTIGATE_STRICT", "strict"],
            help="Use strict history (isolate by history isolation keys).",
        ),
    ] = False,
    retries: Annotated[
        int,
        typer.Option(
            envvar="retries",
            help="Number of retries for openQA API queries.",
        ),
    ] = 3,
    retry_sleep_time: Annotated[
        int,
        typer.Option(
            envvar="OPENQA_CLI_RETRY_SLEEP_TIME_S",
            help="Retry sleep time in seconds.",
        ),
    ] = 20,
    http_timeout: Annotated[
        float,
        typer.Option(
            "--http-timeout",
            envvar=["OPENQA_HTTP_TIMEOUT_S"],
            help="Timeout for HTTP requests in seconds.",
        ),
    ] = DEFAULT_HTTP_TIMEOUT,
    investigation_timeout: Annotated[
        float,
        typer.Option(
            "--investigation-timeout",
            envvar=["OPENQA_INVESTIGATION_TIMEOUT_S"],
            help="Timeout for investigation_ajax HTTP requests in seconds.",
        ),
    ] = DEFAULT_INVESTIGATION_TIMEOUT,
) -> None:
    """Triggers openQA investigation jobs for a specified job ID or URL."""
    if not verbose:
        env_verbose = os.environ.get("VERBOSE", "").lower()
        if env_verbose in {"1", "true", "yes"}:
            verbose = 1
    setup_logging(verbose)

    if job_id.isdigit():
        parsed_id = int(job_id)
        parsed_scheme = scheme
        parsed_host = host
    else:
        try:
            parsed_id, parsed_scheme, parsed_host = parse_job_url(job_id, scheme, host)
        except ValueError as e:
            log.exception("Error parsing job ID or URL")
            raise typer.Exit(code=1) from e

    host_url = f"{parsed_scheme}://{parsed_host}"

    client = OpenQAClient(
        host_url=host_url,
        retries=retries,
        retry_sleep_time=retry_sleep_time,
        dry_run=dry_run,
        http_timeout=http_timeout,
        investigation_timeout=investigation_timeout,
    )

    run_investigation_logic(
        client,
        parsed_id,
        extra_settings=extra_settings,
        investigation_gid=investigation_gid,
        prio_add=prio_add,
        exclude_name_regex=exclude_name_regex,
        exclude_no_group=exclude_no_group,
        exclude_group_regex=exclude_group_regex,
        force=force,
        strict=strict,
    )



# Copyright SUSE LLC
"""Comment on a failed openQA job if the test code files or needles involved in the failure changed recently.

Runs on an openQA web UI host and reads the test code and needles git checkouts there. The comment must never
contain anything openQA parses as a bugref or label, hence no commit subject goes in unsanitized.
"""

from __future__ import annotations

import datetime as dt
import json
import logging
import re
import subprocess
import sys
from pathlib import Path
from typing import Annotated, NamedTuple
from urllib.parse import urlparse, urlunparse

import httpx
import typer

from common.error_handling import is_404_str
from openqa_llm_investigate.failures import extract_failed_modules, extract_test_died_errors, failing_cluster
from openqa_llm_investigate.http import AnalyzerError, JsonDict, OpenQA

USER_AGENT = "openqa-recent-test-changes (https://github.com/os-autoinst/os-autoinst-scripts)"
CODE_MARKER = "**Recent test code changes:**"
NEEDLE_MARKER = "**Recent needle changes:**"
DAYS = 5
CODE_HEADER = f"{CODE_MARKER} files in this failure were modified in the {DAYS} days before the job ran:"
NEEDLE_HEADER = (
    f"{NEEDLE_MARKER} needles of the failed screen checks (or tagged for them) changed in the last {DAYS} days:"
)
MODULES_MAX = 3
FILES_MAX = 50
COMMITS_MAX = 30
FILE_NAMES_MAX = 10
SUBJECT_MAX = 100
TESTS_ROOTS = (Path("/var/lib/openqa/share/tests"), Path("/var/lib/openqa/tests"))
_PATH_RE = re.compile(r"[\w./-]+\.(?:pm|py)\b")
_DISTRI_RE = re.compile(r"[\w.-]+")
_REL_PATH_RE = re.compile(r"[\w./-]+")
_TAG_RE = re.compile(r"[A-Za-z0-9_.:+-]+")
_NO_NEEDLE_RE = re.compile(r"no candidate needle with tag\(s\) '([^']+)'")
_STATUS_TEXT = {"A": " (added)", "D": " (removed)"}
_SHA_RE = re.compile(r"[0-9a-f]{7,40}")
_HTTP_REMOTE_RE = re.compile(r"https?://[\w.-]+(?::\d+)?/[\w./-]+")
_SCP_REMOTE_RE = re.compile(r"(?:[\w.-]+@)?([\w.-]+):([\w./-]+)")
# a `#` or `:` glued to the next character is what makes bugrefs (poo#1), labels (label:x) and URLs
_GLUED_RE = re.compile(r"(?<=\w)#(?!\s)|:(?!\s|$)")

log = logging.getLogger(__name__)
app = typer.Typer(add_completion=False)


class Commit(NamedTuple):
    """A commit changing some of the involved files; `changes` are (git status letter, file name)."""

    sha: str
    date: str
    ts: int
    subject: str
    changes: list[tuple[str, str]]


def parse_job_url(job_url: str) -> tuple[str, str]:
    """Parse a job URL or ID into a base URL and job ID."""
    parsed_url = urlparse(job_url)
    if parsed_url.scheme:
        base_url = urlunparse((parsed_url.scheme, parsed_url.netloc, "", "", "", ""))
        return base_url, parsed_url.path.replace("/tests/", "", 1)
    return "https://openqa.opensuse.org", job_url


def post_comment(base_url: str, job_id: str, comment: str) -> None:
    """Post a comment to an openQA job."""
    cmd = ["openqa-cli", "api", "--header", f"User-Agent: {USER_AGENT}", "--host", base_url]
    cmd += ["-X", "POST", f"jobs/{job_id}/comments", f"text={comment}"]
    try:
        subprocess.run(cmd, check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as e:
        if is_404_str(e.stderr):
            log.info("Could not post comment as job %s has been deleted.", job_id)
            return
        log.exception("Failed to post comment: %s", e.stderr)
        sys.exit(1)


def tests_dir(settings: JsonDict) -> Path | None:
    """Return the test code checkout of a job like openQA's `testcasedir`, None if the job did not use one."""
    casedir = settings.get("CASEDIR")
    if casedir and ("://" in casedir or casedir.startswith("/")):
        return None
    distri = casedir or settings.get("DISTRI")
    root = next((r for r in TESTS_ROOTS if r.is_dir()), None)
    if not root or not distri or not _DISTRI_RE.fullmatch(distri):
        return None
    version = settings.get("VERSION")
    versioned = root / f"{distri}-{version}"
    repo = versioned if version and versioned.exists() else root / distri
    return repo if repo.is_dir() else None


def needles_dir(settings: JsonDict, tests: Path | None) -> Path | None:
    """Return the needles git checkout of a job, None if it has none or the job did not use one of this host."""
    setting = settings.get("NEEDLES_DIR")
    if setting and "://" in setting:
        return None
    if setting and setting.startswith("/"):
        path = Path(setting).resolve()
        found = path if any(path.is_relative_to(r.resolve()) for r in TESTS_ROOTS) else None
    elif tests and setting:
        found = None if ".." in Path(setting).parts else tests / setting
    elif tests:
        distri = settings.get("DISTRI") or ""
        product = tests / "products" / distri
        found = (product if _DISTRI_RE.fullmatch(distri) and product.is_dir() else tests) / "needles"
    else:
        found = None
    return found if found and (found / ".git").exists() else None


def _git(repo: Path, *args: str) -> str:
    """Run git in `repo`; `safe.directory` on the command line avoids the dubious ownership error for other users."""
    cmd = ["git", "-c", f"safe.directory={repo}", "-C", str(repo), *args]
    return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout


def resolve_path(repo: Path, path: str) -> str | None:
    """Return the repo-relative form of a path from a stack trace: its shortest suffix that is a file in `repo`."""
    parts = [p for p in path.split("/") if p]
    if ".." in parts:
        return None
    return next(("/".join(parts[i:]) for i in range(len(parts)) if (repo / "/".join(parts[i:])).is_file()), None)


def involved_files(repo: Path, modules: list[JsonDict]) -> list[str]:
    """Return the files of the stack traces of the failed modules, or else the modules' own test files."""
    found: dict[str, None] = {}
    for module in modules:
        texts = [d.get("text_data") or "" for d in extract_test_died_errors(module)]
        paths = [p for text in texts for p in _PATH_RE.findall(text)]
        resolved = [r for p in paths if (r := resolve_path(repo, p))]
        if not resolved and module.get("category") and module.get("name"):
            own = resolve_path(repo, f"tests/{module['category']}/{module['name']}.pm")
            resolved = [own] if own else []
        found.update(dict.fromkeys(resolved))
    return list(found)


def _needle_files(needles: Path, candidate: JsonDict) -> list[str]:
    """Return the existing JSON file and PNG of a candidate needle of a failed screen step."""
    rel = candidate.get("json")
    if not isinstance(rel, str) or not _REL_PATH_RE.fullmatch(rel) or rel.startswith("/") or ".." in rel.split("/"):
        return []
    names = [rel, f"{rel.removesuffix('.json')}.png"] if rel.endswith(".json") else [rel]
    return [n for n in names if (needles / n).is_file()]


def involved_needles(needles: Path, modules: list[JsonDict]) -> tuple[list[str], list[str]]:
    """Return the candidate needle files and the tags of the failed screen steps of the failed modules."""
    files: dict[str, None] = {}
    tags: dict[str, None] = {}
    for module in modules:
        cluster = failing_cluster(module.get("details", []))
        for step in cluster[0] if cluster else []:
            for candidate in step.get("needles") or []:
                files.update(dict.fromkeys(_needle_files(needles, candidate)))
            listed = [t for t in step.get("tags") or [] if isinstance(t, str)]
            listed += [t for m in _NO_NEEDLE_RE.findall(step.get("text_data") or "") for t in re.split(r"[\s,]+", m)]
            tags.update(dict.fromkeys(t for t in listed if _TAG_RE.fullmatch(t)))
    return list(files), list(tags)


def tested_rev(repo: Path, vars_json: JsonDict, kind: str, settings: JsonDict) -> str | None:
    """Return the job's `<kind>_GIT_HASH` if the checkout has it, else HEAD (None if the job used a refspec)."""
    sha = str(vars_json.get(f"{kind}_GIT_HASH") or "")
    if _SHA_RE.fullmatch(sha):
        try:
            _git(repo, "cat-file", "-e", f"{sha}^{{commit}}")
        except subprocess.CalledProcessError:
            pass
        else:
            return sha
    return None if settings.get(f"{kind}_GIT_REFSPEC") else "HEAD"


def _log(repo: Path, rev: str, started: dt.datetime, *selection: str) -> list[Commit]:
    """Return the commits of the `DAYS` days before `started` that match the git log `selection`, newest first."""
    since, until = (started - dt.timedelta(days=DAYS)).isoformat(), started.isoformat()
    fmt = "--format=%x00%H%x1f%cs%x1f%ct%x1f%s"
    args = ["log", rev, f"--since={since}", f"--until={until}", "--no-merges", "--no-renames", "--name-status", fmt]
    commits = []
    for chunk in _git(repo, *args, *selection).split("\0")[1:]:
        header, *lines = chunk.splitlines()
        sha, date, ts, subject = header.split("\x1f", 3)
        changes = [
            (status[:1], name)
            for line in lines
            if (status := line.partition("\t")[0]) and (name := line.partition("\t")[2])
        ]
        commits.append(Commit(sha, date, int(ts), subject, changes))
    return commits


def recent_commits(repo: Path, rev: str, started: dt.datetime, files: list[str]) -> list[Commit]:
    """Return the commits to `files` in the `DAYS` days before `started`, newest first."""
    if not files:
        return []
    commits = [
        c._replace(changes=[(s, n) for s, n in c.changes if n in files]) for c in _log(repo, rev, started, "--", *files)
    ]
    return [c for c in commits if c.changes]


def tagged_commits(repo: Path, rev: str, started: dt.datetime, tags: list[str]) -> list[Commit]:
    """Return the commits that added, removed or edited a needle JSON line with one of `tags`."""
    if not tags:
        return []
    pattern = "|".join(re.sub(r"[.+]", r"\\\g<0>", tag) for tag in tags)
    return _log(repo, rev, started, f'-G"({pattern})"', "--", "*.json")


def merge_commits(*groups: list[Commit]) -> list[Commit]:
    """Return the commits of all `groups` once each with their changes joined, newest first."""
    merged: dict[str, Commit] = {}
    for commit in (c for group in groups for c in group):
        known = merged.get(commit.sha)
        joined = list(dict.fromkeys([*(known.changes if known else []), *commit.changes]))
        merged[commit.sha] = commit._replace(changes=joined)
    return sorted(merged.values(), key=lambda c: c.ts, reverse=True)


def commit_url_base(repo: Path) -> str | None:
    """Return the web URL prefix of commits of the checkout's origin (None for unknown or credentialed remotes)."""
    try:
        remote = _git(repo, "remote", "get-url", "origin").strip().removesuffix("/").removesuffix(".git")
    except subprocess.CalledProcessError:
        return None
    if _HTTP_REMOTE_RE.fullmatch(remote):
        return f"{remote}/commit/"
    if (m := _SCP_REMOTE_RE.fullmatch(remote)) and "://" not in remote:
        return f"https://{m.group(1)}/{m.group(2)}/commit/"
    return None


def sanitize_subject(subject: str) -> str:
    """Return the subject with a space after each `#`/`:` glued to a word, so openQA finds no bugref or label in it."""
    return _GLUED_RE.sub(lambda m: m.group() + " ", subject.strip()[:SUBJECT_MAX])


def _changes_text(changes: list[tuple[str, str]]) -> str:
    shown = ", ".join(f"`{name}`{_STATUS_TEXT.get(status, '')}" for status, name in changes[:FILE_NAMES_MAX])
    more = len(changes) - FILE_NAMES_MAX
    return shown + (f", +{more} more files" if more > 0 else "")


def format_section(header: str, base: str | None, commits: list[Commit], notes: list[str]) -> str | None:
    """Return a section listing the newest `COMMITS_MAX` of `commits` (None without any), with markdown links."""
    if not commits:
        return None
    lines = [header]
    for commit in commits[:COMMITS_MAX]:
        ref = f"[{commit.sha[:7]}]({base}{commit.sha})" if base else f"`{commit.sha[:7]}`"
        lines.append(f"* {ref} {commit.date} {sanitize_subject(commit.subject)}: {_changes_text(commit.changes)}")
    if len(commits) > COMMITS_MAX:
        lines.append(f"* ... and {len(commits) - COMMITS_MAX} more older commits not shown (limit {COMMITS_MAX})")
    return "\n".join([*lines, *(f"* {n}" for n in notes)])


def _cap_note(what: str, total: int) -> list[str]:
    return [f"Only the first {FILES_MAX} of {total} involved {what} were checked."] if total > FILES_MAX else []


def _job_start(job: JsonDict) -> dt.datetime:
    started = job.get("t_started")
    return dt.datetime.fromisoformat(started).replace(tzinfo=dt.UTC) if started else dt.datetime.now(dt.UTC)


def _vars(oqa: OpenQA, job_id: str) -> JsonDict:
    try:
        return json.loads(oqa.job_file(job_id, "vars.json") or "{}")
    except ValueError:
        return {}


def _skip_reason(oqa: OpenQA, job_id: str, job: JsonDict) -> str | None:
    if job.get("result") in {"passed", "softfailed"} or ":investigate:" in job.get("test", ""):
        return f"job {job_id} passed or is an investigation job"
    try:
        comments = oqa.json(f"/api/v1/jobs/{job_id}/comments")
    except AnalyzerError:
        return None
    if any(c.get("text", "").startswith((CODE_MARKER, NEEDLE_MARKER)) for c in comments):
        return f"job {job_id} already has the comment"
    return None


def code_section(repo: Path, modules: list[JsonDict], job: JsonDict, vars_json: JsonDict) -> str | None:
    """Return the section on recent changes to the test code files involved in the failed modules."""
    settings = job.get("settings") or {}
    found = involved_files(repo, modules)
    if not found or not (rev := tested_rev(repo, vars_json, "TEST", settings)):
        return None
    commits = recent_commits(repo, rev, _job_start(job), found[:FILES_MAX])
    return format_section(CODE_HEADER, commit_url_base(repo), commits, _cap_note("files", len(found)))


def needle_section(repo: Path, modules: list[JsonDict], job: JsonDict, vars_json: JsonDict) -> str | None:
    """Return the section on recent changes to the needles of the failed screen checks."""
    settings = job.get("settings") or {}
    files, tags = involved_needles(repo, modules)
    if not (files or tags) or not (rev := tested_rev(repo, vars_json, "NEEDLES", settings)):
        return None
    started = _job_start(job)
    commits = merge_commits(
        recent_commits(repo, rev, started, files[:FILES_MAX]), tagged_commits(repo, rev, started, tags[:FILES_MAX])
    )
    notes = _cap_note("needle files", len(files)) + _cap_note("tags", len(tags))
    return format_section(NEEDLE_HEADER, commit_url_base(repo), commits, notes)


def build_comment(oqa: OpenQA, job_id: str) -> str | None:
    """Return the comment for a job, None when there is nothing to report."""
    job = oqa.json(f"/api/v1/jobs/{job_id}")["job"]
    if reason := _skip_reason(oqa, job_id, job):
        log.info("Skipping: %s", reason)
        return None
    tests = tests_dir(job.get("settings") or {})
    needles = needles_dir(job.get("settings") or {}, tests)
    if not tests and not needles:
        log.info("Skipping: job %s did not use a local test code or needles checkout", job_id)
        return None
    modules = extract_failed_modules(oqa.json(f"/tests/{job_id}/details_ajax"))[:MODULES_MAX]
    vars_json = _vars(oqa, job_id)
    sections = [
        code_section(tests, modules, job, vars_json) if tests else None,
        needle_section(needles, modules, job, vars_json) if needles else None,
    ]
    return "\n\n".join(s for s in sections if s) or None


@app.command()
def main(
    job_url: str = typer.Argument(..., help="The openQA test URL or job ID"),
    dry: Annotated[bool, typer.Option("--dry", help="Print the comment instead of posting it")] = False,  # ruff: ignore[boolean-default-value-positional-argument]
    verbose: Annotated[bool, typer.Option("--verbose", "-v", help="Log why nothing was posted")] = False,  # ruff: ignore[boolean-default-value-positional-argument]
    timeout: Annotated[float, typer.Option("--timeout", envvar="OPENQA_HTTP_TIMEOUT_S", help="HTTP timeout")] = 90.0,
) -> None:
    """Comment on a failed job if test code files or needles involved in the failure changed in the last days."""
    logging.basicConfig(level=logging.INFO if verbose else logging.WARNING, format="%(levelname)s: %(message)s")
    base_url, job_id = parse_job_url(job_url)
    if not job_id.isdigit():
        log.error("Invalid job ID: %s", job_id)
        sys.exit(1)
    try:
        with httpx.Client(headers={"User-Agent": USER_AGENT}, timeout=timeout) as client:
            comment = build_comment(OpenQA(client, base_url), job_id)
    except (AnalyzerError, subprocess.CalledProcessError, OSError, KeyError, ValueError):
        log.exception("Could not check recent test code and needle changes of job %s", job_id)
        sys.exit(1)
    if not comment:
        return
    if dry:
        typer.echo(comment)
    else:
        post_comment(base_url, job_id, comment)


if __name__ == "__main__":
    app()

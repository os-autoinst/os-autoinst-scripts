#!/usr/bin/env python3
# Copyright SUSE LLC
"""Schedule openQA multi-machine ping tests used in CI monitoring jobs."""

from __future__ import annotations

import datetime as dt
import random
import re
import subprocess
import tempfile
from typing import Annotated

import typer
from openqa_client.client import OpenQA_Client
from openqa_client.exceptions import OpenQAClientError

SCENARIO_YAML = """---
products:
  mm-ping-test:
    distri: {distri}
    flavor: {flavor_override}
    arch: {arch}
    version: {version}

machines:
  {machine}:
    backend: qemu
    settings:
      WORKER_CLASS: {worker_class}
      UEFI: '1'

.common: &common
  BOOT_HDD_IMAGE: '1'
  DESKTOP: textmode
  IS_MM_SERVER: '1'
  NICTYPE: tap
  EXPECTED_NM_CONNECTIVITY: '(limited|full)'
  QEMU_DISABLE_SNAPSHOTS: '1'
  YAML_SCHEDULE: schedule/functional/mm_ping.yaml

job_templates:
  ping_server:
    product: mm-ping-test
    machine: {machine}
    settings:
      <<: *common
      HOSTNAME: server
      WORKER_CLASS: {worker_class},{server_host}
  ping_client:
    product: mm-ping-test
    machine: {machine}
    settings:
      <<: *common
      HOSTNAME: client
      WORKER_CLASS: {worker_class},{client_host}
      PARALLEL_WITH: ping_server
"""

ONLINE_STATES = {"idle", "running"}


def pick_hosts(client: OpenQA_Client, worker_class: str) -> tuple[str, str]:
    """Pick a random online host as server and its neighbour as client.

    Over repeated runs every host providing worker_class gets tested.
    """
    try:
        workers = client.openqa_request("GET", "workers").get("workers", [])
    except OpenQAClientError as exc:
        typer.echo(f"Error finding online workers: {exc}", err=True)
        raise typer.Exit(1) from exc
    required = set(worker_class.split(","))
    hosts = sorted({
        worker["host"]
        for worker in workers
        if worker.get("status") in ONLINE_STATES
        and required <= set(worker.get("properties", {}).get("WORKER_CLASS", "").split(","))
    })
    if not hosts:
        typer.echo(f"No online hosts found providing '{worker_class}'", err=True)
        raise typer.Exit(1)
    index = random.randrange(len(hosts))  # ruff: ignore[suspicious-non-cryptographic-random-usage]
    return hosts[index], hosts[(index + 1) % len(hosts)]


app = typer.Typer(add_completion=False, context_settings={"help_option_names": ["-h", "--help"]})


@app.command()
def main(  # ruff: ignore[too-many-arguments]
    *,
    host: Annotated[str, typer.Option(envvar="openqa_url", help="openQA host URL.")] = "https://openqa.opensuse.org",
    distri: Annotated[str, typer.Option(envvar="distri")] = "opensuse",
    flavor: Annotated[str, typer.Option(envvar="flavor", help="Flavor to find the latest passed build for.")] = "DVD",
    flavor_override: Annotated[
        str, typer.Option(envvar="flavor_override", help="Flavor to schedule with, avoids obsoletion.")
    ] = "mm-monitoring",
    arch: Annotated[str, typer.Option(envvar="arch")] = "x86_64",
    version: Annotated[str, typer.Option(envvar="version")] = "Tumbleweed",
    test_name: Annotated[
        str, typer.Option(envvar="test_name", help="Test to find the latest passed build for.")
    ] = "ping_client",
    build_regex: Annotated[
        str, typer.Option(envvar="build_regex", help="Regex a passed job's BUILD must match.")
    ] = r"^[0-9]+$",
    machine: Annotated[str, typer.Option(envvar="machine")] = "uefi",
    worker_class: Annotated[
        str | None, typer.Option(envvar="worker_class", help="Worker classes to test, defaults to 'qemu_<arch>,tap'.")
    ] = None,
    monitor: Annotated[bool, typer.Option("--monitor/--no-monitor", help="Monitor jobs until completion.")] = True,
    follow: Annotated[bool, typer.Option("--follow/--no-follow", help="Follow jobs if restarted or cloned.")] = True,
    poll_interval: Annotated[
        int | None, typer.Option(help="Seconds between job polls; defaults to openqa-cli's.")
    ] = None,
) -> None:
    """Schedule openQA multi-machine ping tests used in CI monitoring jobs."""
    try:
        pattern = re.compile(build_regex)
    except re.error as exc:
        msg = f"invalid regex: {exc}"
        raise typer.BadParameter(msg, param_hint="--build-regex") from exc

    try:
        jobs = (
            OpenQA_Client(server=host)
            .openqa_request(
                "GET",
                "jobs",
                params={
                    "version": version,
                    "scope": "relevant",
                    "arch": arch,
                    "machine": machine,
                    "flavor": flavor,
                    "test": test_name,
                    "latest": 1,
                },
            )
            .get("jobs", [])
        )
    except OpenQAClientError as exc:
        typer.echo(f"Error finding latest HDD: {exc}", err=True)
        raise typer.Exit(1) from exc

    passed = [job.get("settings", {}) for job in jobs if job.get("result") == "passed"]
    matching = [settings for settings in passed if pattern.search(settings.get("BUILD", ""))]
    latest = max(matching, key=lambda settings: settings.get("BUILD", ""), default={})
    hdd = latest.get("HDD_1")
    if not hdd:
        typer.echo("Could not find a passed job with HDD_1", err=True)
        raise typer.Exit(1)

    worker_class = worker_class or f"qemu_{arch},tap"
    server_host, client_host = pick_hosts(OpenQA_Client(server=host), worker_class)
    build = dt.datetime.now().astimezone().isoformat(timespec="minutes")
    settings = {
        "DISTRI": distri,
        "VERSION": version,
        "FLAVOR": flavor_override,
        "ARCH": arch,
        "BUILD": build,
        "_GROUP_ID": "0",
        "HDD_1": hdd,
    }
    if pflash_vars := latest.get("UEFI_PFLASH_VARS"):
        settings["UEFI_PFLASH_VARS"] = pflash_vars
    cmd = ["openqa-cli", "schedule", "--host", host]
    if poll_interval is not None:
        cmd += ["--poll-interval", str(poll_interval)]
    if monitor:
        cmd.append("--monitor")
    if follow:
        cmd.append("--follow")

    scenario_yaml = SCENARIO_YAML.format(
        distri=distri,
        flavor_override=flavor_override,
        arch=arch,
        version=version,
        machine=machine,
        worker_class=worker_class,
        server_host=server_host,
        client_host=client_host,
    )
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".yaml") as scenario_file:
        scenario_file.write(scenario_yaml)
        scenario_file.flush()
        cmd += ["--param-file", f"SCENARIO_DEFINITIONS_YAML={scenario_file.name}"]
        cmd += [f"{key}={value}" for key, value in settings.items()]
        try:
            returncode = subprocess.run(cmd, check=False).returncode
        except FileNotFoundError:
            typer.echo("openqa-cli not found", err=True)
            returncode = 1
    raise typer.Exit(returncode)


if __name__ == "__main__":  # pragma: no cover
    app()
